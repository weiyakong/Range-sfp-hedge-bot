//@version=6
indicator("Daily One Body Levels v0.3", overlay=true, max_lines_count=300, max_labels_count=300)

// Daily One Body logic v0.3
// 1) Adjacent CLOSED Daily candles only.
// 2) Opposite-color pairs only: one bullish candle and one bearish candle.
// 3) Matching body edges only:
//    - body high vs body high
//    - body low vs body low
// 4) line.new(... force_overlay=true) is required so levels behave like price-overlay drawings.

toleranceUsd = input.float(100.0, "Daily tolerance USD", minval=1.0, step=1.0)
lookbackPairs = input.int(40, "Daily pairs lookback", minval=2, maxval=150)
minDistanceUsd = input.float(250.0, "Min distance between separate levels USD", minval=0.0, step=10.0)
maxLevels = input.int(12, "Max Daily levels", minval=1, maxval=100)
labelOffsetBars = input.int(6, "Label offset", minval=1, maxval=200)
labelOffsetUsd = input.float(15.0, "Label vertical offset USD", minval=0.0, step=1.0)

levelColor = input.color(color.new(color.lime, 0), "Daily color")
levelWidth = input.int(1, "Line width", minval=1, maxval=3)
showLabels = input.bool(true, "Show labels")

var line[] dailyLines = array.new_line()
var label[] dailyLabels = array.new_label()
var float[] dailyPrices = array.new_float()

f_clear() =>
    int lineCount = array.size(dailyLines)
    if lineCount > 0
        for i = 0 to lineCount - 1
            line.delete(array.get(dailyLines, i))
    int labelCount = array.size(dailyLabels)
    if labelCount > 0
        for i = 0 to labelCount - 1
            label.delete(array.get(dailyLabels, i))
    array.clear(dailyLines)
    array.clear(dailyLabels)
    array.clear(dailyPrices)
    true

f_isNearExisting(_price) =>
    bool near = false
    int count = array.size(dailyPrices)
    if count > 0
        for i = 0 to count - 1
            if math.abs(array.get(dailyPrices, i) - _price) <= minDistanceUsd
                near := true
    near

f_addLevel(_price, _startBar, _bypassDistance) =>
    bool canAdd = array.size(dailyPrices) < maxLevels and (_bypassDistance or not f_isNearExisting(_price))
    if canAdd
        line ln = line.new(
             x1=_startBar,
             y1=_price,
             x2=bar_index + 1,
             y2=_price,
             xloc=xloc.bar_index,
             extend=extend.right,
             color=levelColor,
             width=levelWidth,
             style=line.style_solid,
             force_overlay=true
        )
        array.push(dailyLines, ln)
        array.push(dailyPrices, _price)

        if showLabels
            label lb = label.new(
                 x=bar_index + labelOffsetBars,
                 y=_price + labelOffsetUsd,
                 text="Daily",
                 xloc=xloc.bar_index,
                 style=label.style_none,
                 textcolor=levelColor,
                 color=color.new(color.white, 100),
                 size=size.small,
                 force_overlay=true
            )
            array.push(dailyLabels, lb)
    true

if barstate.islast
    f_clear()

    for i = 1 to lookbackPairs
        float o1 = open[i]
        float c1 = close[i]
        float o2 = open[i + 1]
        float c2 = close[i + 1]
        int startBar = bar_index - (i + 1)

        bool bull1 = c1 > o1
        bool bear1 = c1 < o1
        bool bull2 = c2 > o2
        bool bear2 = c2 < o2
        bool oppositeColors = (bull1 and bear2) or (bear1 and bull2)

        if oppositeColors
            float high1 = math.max(o1, c1)
            float low1 = math.min(o1, c1)
            float high2 = math.max(o2, c2)
            float low2 = math.min(o2, c2)

            float highDiff = math.abs(high1 - high2)
            float lowDiff = math.abs(low1 - low2)
            bool highMatch = highDiff <= toleranceUsd
            bool lowMatch = lowDiff <= toleranceUsd

            if highMatch
                float highLevel = (high1 + high2) / 2.0
                f_addLevel(highLevel, startBar, false)

            if lowMatch
                float lowLevel = (low1 + low2) / 2.0
                // If both top and bottom of the SAME opposite-color pair match,
                // draw both edges even when they are closer than minDistanceUsd.
                f_addLevel(lowLevel, startBar, highMatch)

    int labelCount = array.size(dailyLabels)
    if labelCount > 0
        for i = 0 to labelCount - 1
            label lb = array.get(dailyLabels, i)
            float p = array.get(dailyPrices, i)
            label.set_x(lb, bar_index + labelOffsetBars)
            label.set_y(lb, p + labelOffsetUsd)
            label.set_text(lb, "Daily")
