//@version=6
indicator("Daily One Body Levels v0.5", overlay=true, max_lines_count=300, max_labels_count=300)

// Daily One Body logic v0.5
// 1) Adjacent CLOSED Daily candles only.
// 2) Opposite-color pairs only: one bullish candle and one bearish candle.
// 3) Matching body edges only:
//    - body high vs body high
//    - body low vs body low
// 4) Levels are removed if AFTER creation price crosses through the level
//    or pierces through and returns. Simple touch does not remove the level.
// 5) line.new(... force_overlay=true) is required so levels behave like price-overlay drawings.

toleranceUsd = input.float(100.0, "Daily tolerance USD", minval=1.0, step=1.0)
lookbackPairs = input.int(40, "Daily pairs lookback", minval=2, maxval=150)
maxLevels = input.int(30, "Max Daily levels", minval=1, maxval=100)
labelOffsetBars = input.int(80, "Label offset", minval=1, maxval=500)
labelOffsetUsd = input.float(15.0, "Label vertical offset USD", minval=0.0, step=1.0)
invalidateBufferUsd = input.float(5.0, "Invalidation buffer USD", minval=0.0, step=1.0)

levelColor = input.color(color.new(color.lime, 0), "Daily color")
levelWidth = input.int(1, "Line width", minval=1, maxval=3)
showLabels = input.bool(true, "Show labels")

var line[] dailyLines = array.new_line()
var label[] dailyLabels = array.new_label()
var float[] dailyPrices = array.new_float()

f_labelText(_price) =>
    "Daily — " + str.tostring(_price, format.mintick)

f_clear() =>
    int lineCount = array.size(dailyLines)
    if lineCount > 0
        for i = 0 to lineCount - 1
            line.delete(array.get(dailyLines, i))
    int labelCount = array.size(dailyLabels)
    if labelCount > 0
        for i = 0 to labelCount - 1
            label.delete(array.get(dailyLabels, i))
    array.clear(dailyLines)
    array.clear(dailyLabels)
    array.clear(dailyPrices)
    true

f_addLevel(_price, _startBar) =>
    if array.size(dailyPrices) < maxLevels
        line ln = line.new(
             x1=_startBar,
             y1=_price,
             x2=bar_index + 1,
             y2=_price,
             xloc=xloc.bar_index,
             extend=extend.right,
             color=levelColor,
             width=levelWidth,
             style=line.style_solid,
             force_overlay=true
        )
        array.push(dailyLines, ln)
        array.push(dailyPrices, _price)

        if showLabels
            label lb = label.new(
                 x=bar_index + labelOffsetBars,
                 y=_price + labelOffsetUsd,
                 text=f_labelText(_price),
                 xloc=xloc.bar_index,
                 style=label.style_none,
                 textcolor=levelColor,
                 color=color.new(color.white, 100),
                 size=size.small,
                 force_overlay=true
            )
            array.push(dailyLabels, lb)
    true

f_barInvalidates(_level, _barIndex) =>
    float upper = _level + invalidateBufferUsd
    float lower = _level - invalidateBufferUsd

    bool bodyCrossUp = open[_barIndex] < lower and close[_barIndex] > upper
    bool bodyCrossDown = open[_barIndex] > upper and close[_barIndex] < lower

    bool wickThroughReturnFromAbove = open[_barIndex] > upper and low[_barIndex] < lower and close[_barIndex] > upper
    bool wickThroughReturnFromBelow = open[_barIndex] < lower and high[_barIndex] > upper and close[_barIndex] < lower

    bool fullRangeThrough = high[_barIndex] > upper and low[_barIndex] < lower

    bodyCrossUp or bodyCrossDown or wickThroughReturnFromAbove or wickThroughReturnFromBelow or fullRangeThrough

f_invalidatedAfterCreation(_level, _newerCandleIndex) =>
    bool invalid = false

    // Candidate level is created by candles [_newerCandleIndex] and [_newerCandleIndex + 1].
    // After creation, only bars newer than _newerCandleIndex can invalidate it:
    // [_newerCandleIndex - 1] ... [0]. Bar 0 is current and updates live.
    if _newerCandleIndex > 0
        for k = 0 to _newerCandleIndex - 1
            if f_barInvalidates(_level, k)
                invalid := true

    invalid

f_tryAddEdge(_p1, _p2, _startBar, _newerCandleIndex) =>
    float diff = math.abs(_p1 - _p2)
    if diff <= toleranceUsd
        float level = (_p1 + _p2) / 2.0
        if not f_invalidatedAfterCreation(level, _newerCandleIndex)
            f_addLevel(level, _startBar)
    true

if barstate.islast
    f_clear()

    for i = 1 to lookbackPairs
        float o1 = open[i]
        float c1 = close[i]
        float o2 = open[i + 1]
        float c2 = close[i + 1]
        int startBar = bar_index - (i + 1)

        bool bull1 = c1 > o1
        bool bear1 = c1 < o1
        bool bull2 = c2 > o2
        bool bear2 = c2 < o2
        bool oppositeColors = (bull1 and bear2) or (bear1 and bull2)

        if oppositeColors
            float high1 = math.max(o1, c1)
            float low1 = math.min(o1, c1)
            float high2 = math.max(o2, c2)
            float low2 = math.min(o2, c2)

            f_tryAddEdge(high1, high2, startBar, i)
            f_tryAddEdge(low1, low2, startBar, i)

    int labelCount = array.size(dailyLabels)
    if labelCount > 0
        for i = 0 to labelCount - 1
            label lb = array.get(dailyLabels, i)
            float p = array.get(dailyPrices, i)
            label.set_x(lb, bar_index + labelOffsetBars)
            label.set_y(lb, p + labelOffsetUsd)
            label.set_text(lb, f_labelText(p))
