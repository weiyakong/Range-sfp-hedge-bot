//@version=6
indicator("D/W/M Body Levels v0.1.1", overlay=true, max_lines_count=500, max_labels_count=500)

// D/W/M Body Levels v0.1.1
// Draws body levels from CLOSED Daily / Weekly / Monthly candles.
// Body levels = open and close of the higher-timeframe candle.
// Lines extend right. Labels sit at the right edge near the price scale.
// A level is deleted after price touches it.

showD = input.bool(true, "Show Daily body levels")
showW = input.bool(true, "Show Weekly body levels")
showM = input.bool(true, "Show Monthly body levels")

keepD = input.int(20, "Max Daily levels", minval=1, maxval=150)
keepW = input.int(20, "Max Weekly levels", minval=1, maxval=150)
keepM = input.int(20, "Max Monthly levels", minval=1, maxval=150)

labelOffsetBars = input.int(8, "Label offset to price scale", minval=1, maxval=100)
lineWidthD = input.int(1, "Daily line width", minval=1, maxval=4)
lineWidthW = input.int(1, "Weekly line width", minval=1, maxval=4)
lineWidthM = input.int(2, "Monthly line width", minval=1, maxval=4)

removeOnTouch = input.bool(true, "Remove level after touch")
touchOnlyAfterBars = input.int(1, "Ignore touches for N bars after creation", minval=0, maxval=20)
mergeTicks = input.int(10, "Merge duplicate levels within ticks", minval=0, maxval=500)

// Colors:
// Daily = gray, Weekly = aqua/teal, Monthly = orange/gold.
dColor = input.color(color.new(color.gray, 25), "Daily color")
wColor = input.color(color.new(color.aqua, 0), "Weekly color")
mColor = input.color(color.new(color.orange, 0), "Monthly color")

// Closed HTF body values.
dOpenPrev = request.security(syminfo.tickerid, "D", open[1], barmerge.gaps_off, barmerge.lookahead_off)
dClosePrev = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_off)
wOpenPrev = request.security(syminfo.tickerid, "W", open[1], barmerge.gaps_off, barmerge.lookahead_off)
wClosePrev = request.security(syminfo.tickerid, "W", close[1], barmerge.gaps_off, barmerge.lookahead_off)
mOpenPrev = request.security(syminfo.tickerid, "M", open[1], barmerge.gaps_off, barmerge.lookahead_off)
mClosePrev = request.security(syminfo.tickerid, "M", close[1], barmerge.gaps_off, barmerge.lookahead_off)

newDay = ta.change(time("D")) != 0
newWeek = ta.change(time("W")) != 0
newMonth = ta.change(time("M")) != 0

var line[] levelLines = array.new_line()
var label[] levelLabels = array.new_label()
var float[] levelPrices = array.new_float()
var string[] levelNames = array.new_string()
var int[] levelCreatedBars = array.new_int()
var string[] levelTf = array.new_string()

f_touch(_price) =>
    high >= _price and low <= _price

f_isDuplicate(_price, _tf) =>
    bool dup = false
    tolerance = syminfo.mintick * mergeTicks
    if array.size(levelPrices) > 0
        for i = 0 to array.size(levelPrices) - 1
            p = array.get(levelPrices, i)
            tf = array.get(levelTf, i)
            if tf == _tf and math.abs(p - _price) <= tolerance
                dup := true
    dup

f_countTf(_tf) =>
    int c = 0
    if array.size(levelTf) > 0
        for i = 0 to array.size(levelTf) - 1
            if array.get(levelTf, i) == _tf
                c += 1
    c

f_deleteIndex(_idx) =>
    line.delete(array.get(levelLines, _idx))
    label.delete(array.get(levelLabels, _idx))
    array.remove(levelLines, _idx)
    array.remove(levelLabels, _idx)
    array.remove(levelPrices, _idx)
    array.remove(levelNames, _idx)
    array.remove(levelCreatedBars, _idx)
    array.remove(levelTf, _idx)

f_trimTf(_tf, _maxCount) =>
    while f_countTf(_tf) > _maxCount
        int oldestIdx = na
        int oldestBar = 1000000000
        if array.size(levelTf) > 0
            for i = 0 to array.size(levelTf) - 1
                if array.get(levelTf, i) == _tf
                    cb = array.get(levelCreatedBars, i)
                    if cb < oldestBar
                        oldestBar := cb
                        oldestIdx := i
        if not na(oldestIdx)
            f_deleteIndex(oldestIdx)
        else
            break

f_addLevel(_tf, _name, _price, _color, _width, _maxCount) =>
    if not na(_price) and not f_isDuplicate(_price, _tf)
        ln = line.new(bar_index, _price, bar_index + 1, _price, xloc=xloc.bar_index, extend=extend.right, color=_color, width=_width)
        txt = _name + " — " + str.tostring(_price, format.mintick)
        lb = label.new(bar_index + labelOffsetBars, _price, txt, xloc=xloc.bar_index, style=label.style_none, textcolor=_color, color=color.new(color.white, 100), size=size.small)
        array.push(levelLines, ln)
        array.push(levelLabels, lb)
        array.push(levelPrices, _price)
        array.push(levelNames, _name)
        array.push(levelCreatedBars, bar_index)
        array.push(levelTf, _tf)
        f_trimTf(_tf, _maxCount)

f_addBodyLevels(_tf, _prefix, _open, _close, _color, _width, _maxCount) =>
    bodyHigh = math.max(_open, _close)
    bodyLow = math.min(_open, _close)
    f_addLevel(_tf, _prefix + " body high", bodyHigh, _color, _width, _maxCount)
    if math.abs(bodyHigh - bodyLow) > syminfo.mintick * mergeTicks
        f_addLevel(_tf, _prefix + " body low", bodyLow, _color, _width, _maxCount)

if showD and newDay
    f_addBodyLevels("D", "D", dOpenPrev, dClosePrev, dColor, lineWidthD, keepD)

if showW and newWeek
    f_addBodyLevels("W", "W", wOpenPrev, wClosePrev, wColor, lineWidthW, keepW)

if showM and newMonth
    f_addBodyLevels("M", "M", mOpenPrev, mClosePrev, mColor, lineWidthM, keepM)

// Keep labels at the right edge, directly before the price scale.
if barstate.islast and array.size(levelLabels) > 0
    for i = 0 to array.size(levelLabels) - 1
        lb = array.get(levelLabels, i)
        p = array.get(levelPrices, i)
        name = array.get(levelNames, i)
        label.set_x(lb, bar_index + labelOffsetBars)
        label.set_y(lb, p)
        label.set_text(lb, name + " — " + str.tostring(p, format.mintick))

// Delete levels after touch. A new level is protected for N bars after creation.
if removeOnTouch and array.size(levelPrices) > 0
    for i = array.size(levelPrices) - 1 to 0
        p = array.get(levelPrices, i)
        created = array.get(levelCreatedBars, i)
        canDelete = bar_index - created > touchOnlyAfterBars
        if canDelete and f_touch(p)
            f_deleteIndex(i)
