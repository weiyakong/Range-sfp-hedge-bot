//@version=6
indicator("D/W/M Levels Origin + Projection v0.1", overlay=true, max_lines_count=500, max_labels_count=500, max_bars_back=5000)

showDaily   = input.bool(true,  "Show Daily levels")
showWeekly  = input.bool(true,  "Show Weekly levels")
showMonthly = input.bool(true,  "Show Monthly levels")

maxLevelsPerTf = input.int(80, "Max active levels per TF", minval=10, maxval=150)
projectionLeftBars  = input.int(200, "Projection mode: bars left", minval=20, maxval=2000)
projectionRightBars = input.int(80,  "Label/line offset right", minval=5, maxval=300)

originModeOnDwm = input.bool(true, "Origin mode on D/W/M charts")
removeWhenCrossedThrough = input.bool(true, "Remove when price crosses through")

lineWidth = input.int(1, "Line width", minval=1, maxval=4)
labelSizeInput = input.string("Small", "Label size", options=["Tiny", "Small", "Normal"])

dailyColor   = input.color(color.new(color.lime, 0), "Daily color")
weeklyColor  = input.color(color.new(color.orange, 0), "Weekly color")
monthlyColor = input.color(color.new(color.white, 0), "Monthly color")

var float[] levelPrices = array.new_float()
var string[] levelNames = array.new_string()
var string[] levelTf    = array.new_string()
var int[] levelTimes    = array.new_int()
var line[] levelLines   = array.new_line()
var label[] levelLabels = array.new_label()

f_labelSize() =>
    labelSizeInput == "Tiny" ? size.tiny : labelSizeInput == "Normal" ? size.normal : size.small

f_tfColor(string tf) =>
    tf == "D" ? dailyColor : tf == "W" ? weeklyColor : monthlyColor

f_tfName(string tf) =>
    tf == "D" ? "Daily" : tf == "W" ? "Weekly" : "Monthly"

f_chartMs() =>
    int sec = timeframe.in_seconds(timeframe.period)
    int safeSec = na(sec) or sec <= 0 ? 86400 : sec
    safeSec * 1000

f_isOriginMode() =>
    originModeOnDwm and (timeframe.isdaily or timeframe.isweekly or timeframe.ismonthly)

f_countTf(string tf) =>
    int count = 0
    int n = array.size(levelTf)
    if n > 0
        for i = 0 to n - 1
            if array.get(levelTf, i) == tf
                count += 1
    count

f_levelExists(string tf, int originTime, float price) =>
    bool exists = false
    int n = array.size(levelPrices)
    if n > 0
        for i = 0 to n - 1
            bool sameTf = array.get(levelTf, i) == tf
            bool sameTime = array.get(levelTimes, i) == originTime
            bool samePrice = math.abs(array.get(levelPrices, i) - price) <= syminfo.mintick * 2
            if sameTf and sameTime and samePrice
                exists := true
    exists

f_deleteLevel(int idx) =>
    line.delete(array.get(levelLines, idx))
    label.delete(array.get(levelLabels, idx))
    array.remove(levelPrices, idx)
    array.remove(levelNames, idx)
    array.remove(levelTf, idx)
    array.remove(levelTimes, idx)
    array.remove(levelLines, idx)
    array.remove(levelLabels, idx)
    true

f_trimTf(string tf) =>
    while f_countTf(tf) > maxLevelsPerTf
        int removeIdx = na
        int n = array.size(levelTf)
        for i = 0 to n - 1
            if na(removeIdx) and array.get(levelTf, i) == tf
                removeIdx := i
        if not na(removeIdx)
            f_deleteLevel(removeIdx)
        else
            break
    true

f_addLevel(string tf, int originTime, float price) =>
    if not na(price) and not na(originTime) and not f_levelExists(tf, originTime, price)
        color col = f_tfColor(tf)
        int nowMs = f_chartMs()
        bool originMode = f_isOriginMode()
        int x1 = originMode ? originTime : time - projectionLeftBars * nowMs
        int x2 = time + projectionRightBars * nowMs
        string txt = f_tfName(tf) + " " + str.tostring(price, format.mintick)
        line ln = line.new(x1=x1, y1=price, x2=x2, y2=price, xloc=xloc.bar_time, extend=extend.none, color=col, width=lineWidth, force_overlay=true)
        label lb = label.new(x=x2, y=price, text=txt, xloc=xloc.bar_time, style=label.style_none, textcolor=col, color=color.new(color.white, 100), size=f_labelSize(), force_overlay=true)
        array.push(levelPrices, price)
        array.push(levelNames, txt)
        array.push(levelTf, tf)
        array.push(levelTimes, originTime)
        array.push(levelLines, ln)
        array.push(levelLabels, lb)
        f_trimTf(tf)
    true

f_updateDrawings() =>
    int n = array.size(levelPrices)
    if n > 0
        int nowMs = f_chartMs()
        bool originMode = f_isOriginMode()
        for i = 0 to n - 1
            float price = array.get(levelPrices, i)
            int originTime = array.get(levelTimes, i)
            int x1 = originMode ? originTime : time - projectionLeftBars * nowMs
            int x2 = time + projectionRightBars * nowMs
            line ln = array.get(levelLines, i)
            label lb = array.get(levelLabels, i)
            line.set_x1(ln, x1)
            line.set_x2(ln, x2)
            line.set_y1(ln, price)
            line.set_y2(ln, price)
            label.set_x(lb, x2)
            label.set_y(lb, price)
            label.set_text(lb, array.get(levelNames, i))
    true

f_removeCrossedLevels() =>
    if removeWhenCrossedThrough
        int n = array.size(levelPrices)
        if n > 0
            for k = 0 to n - 1
                int i = n - 1 - k
                float price = array.get(levelPrices, i)
                int originTime = array.get(levelTimes, i)
                bool afterOrigin = time > originTime
                bool crossedThrough = low < price and high > price
                if afterOrigin and crossedThrough
                    f_deleteLevel(i)
    true

[dTime1, dOpen1, dClose1, dOpen2, dClose2] = request.security(syminfo.tickerid, "D", [time[1], open[1], close[1], open[2], close[2]], barmerge.gaps_off, barmerge.lookahead_off)
[wTime1, wOpen1, wClose1, wOpen2, wClose2] = request.security(syminfo.tickerid, "W", [time[1], open[1], close[1], open[2], close[2]], barmerge.gaps_off, barmerge.lookahead_off)
[mTime1, mOpen1, mClose1, mOpen2, mClose2] = request.security(syminfo.tickerid, "M", [time[1], open[1], close[1], open[2], close[2]], barmerge.gaps_off, barmerge.lookahead_off)

f_tryAddBodyJunctionLevel(string tf, bool enabled, int t1, float o1, float c1, float o2, float c2) =>
    if enabled and not na(t1) and not na(o1) and not na(c1) and not na(o2) and not na(c2)
        bool c1Bull = c1 > o1
        bool c1Bear = c1 < o1
        bool c2Bull = c2 > o2
        bool c2Bear = c2 < o2
        bool oppositeBodies = (c1Bull and c2Bear) or (c1Bear and c2Bull)
        if oppositeBodies
            float level = (o1 + c2) / 2.0
            f_addLevel(tf, t1, level)
    true

if timeframe.change("D")
    f_tryAddBodyJunctionLevel("D", showDaily, dTime1, dOpen1, dClose1, dOpen2, dClose2)

if timeframe.change("W")
    f_tryAddBodyJunctionLevel("W", showWeekly, wTime1, wOpen1, wClose1, wOpen2, wClose2)

if timeframe.change("M")
    f_tryAddBodyJunctionLevel("M", showMonthly, mTime1, mOpen1, mClose1, mOpen2, mClose2)

f_removeCrossedLevels()

if barstate.islast
    f_updateDrawings()
