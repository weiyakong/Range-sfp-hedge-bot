//@version=6
indicator("Global Impulse Debug v0.2 STRUCTURE BREAK", overlay=true, max_lines_count=200, max_labels_count=200)

pivotLen = input.int(4, "Global pivot length", minval=2, maxval=10)
lookbackDays = input.int(1825, "Lookback days", minval=100, maxval=3000)
minMovePct = input.float(20.0, "Min global impulse move %", minval=1.0, step=0.5)
structureLookbackPivots = input.int(6, "Structure break lookback pivots", minval=1, maxval=20)
requireStructureBreak = input.bool(true, "Require structure break")
maxImpulses = input.int(20, "Max impulses to draw", minval=1, maxval=80)
lineWidth = input.int(2, "Line width", minval=1, maxval=5)
showLabels = input.bool(true, "Show labels")

bullColor = input.color(color.new(color.lime, 0), "Bullish impulse color")
bearColor = input.color(color.new(color.red, 0), "Bearish impulse color")

var int[] pivBars = array.new_int()
var float[] pivPrices = array.new_float()
var int[] pivTypes = array.new_int()

var line[] impulseLines = array.new_line()
var label[] impulseLabels = array.new_label()

f_clearDrawings() =>
    int lineCount = array.size(impulseLines)
    if lineCount > 0
        for x = 0 to lineCount - 1
            line.delete(array.get(impulseLines, x))
    int labelCount = array.size(impulseLabels)
    if labelCount > 0
        for x = 0 to labelCount - 1
            label.delete(array.get(impulseLabels, x))
    array.clear(impulseLines)
    array.clear(impulseLabels)
    true

f_addPivot(_bar, _price, _type) =>
    int count = array.size(pivBars)
    if count == 0
        array.push(pivBars, _bar)
        array.push(pivPrices, _price)
        array.push(pivTypes, _type)
    else
        int lastType = array.get(pivTypes, count - 1)
        float lastPrice = array.get(pivPrices, count - 1)
        if _type == lastType
            bool replaceHigh = _type == 1 and _price > lastPrice
            bool replaceLow = _type == -1 and _price < lastPrice
            if replaceHigh or replaceLow
                array.set(pivBars, count - 1, _bar)
                array.set(pivPrices, count - 1, _price)
                array.set(pivTypes, count - 1, _type)
        else
            array.push(pivBars, _bar)
            array.push(pivPrices, _price)
            array.push(pivTypes, _type)
    true

f_movePct(_startPrice, _endPrice, _dir) =>
    _dir == 1 ? ((_endPrice - _startPrice) / _startPrice) * 100.0 : ((_startPrice - _endPrice) / _startPrice) * 100.0

f_previousLevel(_fromIndex, _pivotType) =>
    float level = na
    int found = 0
    if _fromIndex > 0
        for j = _fromIndex - 1 to 0
            if na(level) and array.get(pivTypes, j) == _pivotType
                level := array.get(pivPrices, j)
                found += 1
            else if found > 0 and found < structureLookbackPivots and array.get(pivTypes, j) == _pivotType
                float p = array.get(pivPrices, j)
                level := _pivotType == 1 ? math.max(level, p) : math.min(level, p)
                found += 1
    level

f_breaksStructure(_dir, _endPrice, _startPivotIndex) =>
    if not requireStructureBreak
        true
    else
        float prevLevel = _dir == 1 ? f_previousLevel(_startPivotIndex, 1) : f_previousLevel(_startPivotIndex, -1)
        na(prevLevel) ? true : (_dir == 1 ? _endPrice > prevLevel : _endPrice < prevLevel)

f_drawImpulse(_startBar, _startPrice, _endBar, _endPrice, _dir, _movePct, _isLatest) =>
    color col = _dir == 1 ? bullColor : bearColor
    line ln = line.new(x1=_startBar, y1=_startPrice, x2=_endBar, y2=_endPrice, xloc=xloc.bar_index, extend=extend.none, color=col, width=lineWidth, force_overlay=true)
    array.push(impulseLines, ln)
    if showLabels
        string txt = (_dir == 1 ? "Bull BOS " : "Bear BOS ") + str.tostring(_movePct, "#.0") + "%" + (_isLatest ? " latest" : "")
        label lb = label.new(x=_endBar, y=_endPrice, text=txt, xloc=xloc.bar_index, style=label.style_none, textcolor=col, color=color.new(color.white, 100), size=size.small, force_overlay=true)
        array.push(impulseLabels, lb)
    true

ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

if not na(ph)
    int pBar = bar_index - pivotLen
    if bar_index - pBar <= lookbackDays
        f_addPivot(pBar, ph, 1)

if not na(pl)
    int pBar = bar_index - pivotLen
    if bar_index - pBar <= lookbackDays
        f_addPivot(pBar, pl, -1)

if barstate.islast
    f_clearDrawings()
    int pivCount = array.size(pivBars)
    int drawn = 0

    if pivCount >= 2
        for n = 0 to pivCount - 2
            int i = pivCount - 2 - n
            if drawn < maxImpulses
                int type1 = array.get(pivTypes, i)
                int type2 = array.get(pivTypes, i + 1)
                bool bullImpulse = type1 == -1 and type2 == 1
                bool bearImpulse = type1 == 1 and type2 == -1
                if bullImpulse or bearImpulse
                    int dir = bullImpulse ? 1 : -1
                    float startPrice = array.get(pivPrices, i)
                    float endPrice = array.get(pivPrices, i + 1)
                    float move = f_movePct(startPrice, endPrice, dir)
                    int startBar = array.get(pivBars, i)
                    int endBar = array.get(pivBars, i + 1)
                    bool insideLookback = bar_index - startBar <= lookbackDays
                    bool brokeStructure = f_breaksStructure(dir, endPrice, i)
                    if insideLookback and move >= minMovePct and brokeStructure
                        f_drawImpulse(startBar, startPrice, endBar, endPrice, dir, move, drawn == 0)
                        drawn += 1
