//@version=6
indicator("Macro + Sub-macro Impulse Debug v0.5 MAJOR SWINGS", overlay=true, max_lines_count=300, max_labels_count=300)

pivotLen = input.int(4, "Pivot length", minval=2, maxval=10)
lookbackDays = input.int(1825, "Lookback days", minval=100, maxval=3000)
majorSwingMinMovePct = input.float(12.0, "Major swing min move %", minval=1.0, step=0.5)
macroMinMovePct = input.float(20.0, "Macro min move %", minval=1.0, step=0.5)
subMacroMinMovePct = input.float(15.0, "Sub-macro min move %", minval=1.0, step=0.5)
maxMacroImpulses = input.int(20, "Max macro impulses", minval=1, maxval=40)
maxSubPerMacro = input.int(4, "Max sub-macro per macro", minval=1, maxval=10)
showSubMacro = input.bool(false, "Show sub-macro")
showLabels = input.bool(true, "Show labels")

macroWidth = input.int(3, "Macro line width", minval=1, maxval=5)
subWidth = input.int(1, "Sub-macro line width", minval=1, maxval=4)

bullMacroColor = input.color(color.new(color.lime, 0), "Bull macro color")
bearMacroColor = input.color(color.new(color.red, 0), "Bear macro color")
bullSubColor = input.color(color.new(color.lime, 60), "Bull sub-macro color")
bearSubColor = input.color(color.new(color.red, 60), "Bear sub-macro color")

var int[] pivBars = array.new_int()
var float[] pivPrices = array.new_float()
var int[] pivTypes = array.new_int()

var int[] majBars = array.new_int()
var float[] majPrices = array.new_float()
var int[] majTypes = array.new_int()

var int[] macroStartIdx = array.new_int()
var int[] macroEndIdx = array.new_int()
var int[] macroDir = array.new_int()

var line[] lines = array.new_line()
var label[] labels = array.new_label()

f_clearDrawings() =>
    int lineCount = array.size(lines)
    if lineCount > 0
        for x = 0 to lineCount - 1
            line.delete(array.get(lines, x))
    int labelCount = array.size(labels)
    if labelCount > 0
        for x = 0 to labelCount - 1
            label.delete(array.get(labels, x))
    array.clear(lines)
    array.clear(labels)
    true

f_movePct(_startPrice, _endPrice, _dir) =>
    _dir == 1 ? ((_endPrice - _startPrice) / _startPrice) * 100.0 : ((_startPrice - _endPrice) / _startPrice) * 100.0

f_addPivot(_bar, _price, _type) =>
    int count = array.size(pivBars)
    if count == 0
        array.push(pivBars, _bar)
        array.push(pivPrices, _price)
        array.push(pivTypes, _type)
    else
        int lastType = array.get(pivTypes, count - 1)
        float lastPrice = array.get(pivPrices, count - 1)
        if _type == lastType
            bool replaceHigh = _type == 1 and _price > lastPrice
            bool replaceLow = _type == -1 and _price < lastPrice
            if replaceHigh or replaceLow
                array.set(pivBars, count - 1, _bar)
                array.set(pivPrices, count - 1, _price)
                array.set(pivTypes, count - 1, _type)
        else
            array.push(pivBars, _bar)
            array.push(pivPrices, _price)
            array.push(pivTypes, _type)
    true

f_buildMajorSwings() =>
    array.clear(majBars)
    array.clear(majPrices)
    array.clear(majTypes)

    int pivCount = array.size(pivBars)
    if pivCount > 0
        for i = 0 to pivCount - 1
            int pType = array.get(pivTypes, i)
            float pPrice = array.get(pivPrices, i)
            int pBar = array.get(pivBars, i)
            int mc = array.size(majBars)

            if mc == 0
                array.push(majBars, pBar)
                array.push(majPrices, pPrice)
                array.push(majTypes, pType)
            else
                int lastType = array.get(majTypes, mc - 1)
                float lastPrice = array.get(majPrices, mc - 1)

                if pType == lastType
                    bool replaceHigh = pType == 1 and pPrice > lastPrice
                    bool replaceLow = pType == -1 and pPrice < lastPrice
                    if replaceHigh or replaceLow
                        array.set(majBars, mc - 1, pBar)
                        array.set(majPrices, mc - 1, pPrice)
                        array.set(majTypes, mc - 1, pType)
                else
                    int dir = lastType == -1 and pType == 1 ? 1 : -1
                    float move = f_movePct(lastPrice, pPrice, dir)
                    if move >= majorSwingMinMovePct
                        array.push(majBars, pBar)
                        array.push(majPrices, pPrice)
                        array.push(majTypes, pType)
    true

f_drawLine(_startBar, _startPrice, _endBar, _endPrice, _dir, _isMacro, _movePct, _txtSuffix) =>
    color col = _dir == 1 ? (_isMacro ? bullMacroColor : bullSubColor) : (_isMacro ? bearMacroColor : bearSubColor)
    int width = _isMacro ? macroWidth : subWidth
    line ln = line.new(x1=_startBar, y1=_startPrice, x2=_endBar, y2=_endPrice, xloc=xloc.bar_index, extend=extend.none, color=col, width=width, force_overlay=true)
    array.push(lines, ln)
    if showLabels
        string prefix = _isMacro ? "Macro " : "Sub "
        string dirTxt = _dir == 1 ? "Bull " : "Bear "
        string txt = prefix + dirTxt + str.tostring(_movePct, "#.0") + "%" + _txtSuffix
        label lb = label.new(x=_endBar, y=_endPrice, text=txt, xloc=xloc.bar_index, style=label.style_none, textcolor=col, color=color.new(color.white, 100), size=size.small, force_overlay=true)
        array.push(labels, lb)
    true

f_drawSubMacrosForMacro(_macroStartIndex, _macroEndIndex, _dir, _macroStartPrice, _macroEndPrice, _macroEndBar) =>
    int drawnSub = 0
    int span = _macroEndIndex - _macroStartIndex - 1
    if showSubMacro and span > 0
        for n = 0 to span - 1
            int j = _macroEndIndex - 1 - n
            if drawnSub < maxSubPerMacro
                int pType = array.get(majTypes, j)
                float pPrice = array.get(majPrices, j)
                int pBar = array.get(majBars, j)
                bool validBearSub = _dir == -1 and pType == 1 and pPrice < _macroStartPrice and pPrice > _macroEndPrice
                bool validBullSub = _dir == 1 and pType == -1 and pPrice > _macroStartPrice and pPrice < _macroEndPrice
                if validBearSub or validBullSub
                    float move = f_movePct(pPrice, _macroEndPrice, _dir)
                    if move >= subMacroMinMovePct
                        f_drawLine(pBar, pPrice, _macroEndBar, _macroEndPrice, _dir, false, move, "")
                        drawnSub += 1
    true

f_buildSequences() =>
    array.clear(macroStartIdx)
    array.clear(macroEndIdx)
    array.clear(macroDir)

    int count = array.size(majBars)
    int dir = 0
    int seqStart = na
    int seqEnd = na
    int lastHigh = na
    int lastLow = na

    if count >= 2
        for i = 0 to count - 1
            int t = array.get(majTypes, i)
            float p = array.get(majPrices, i)

            if t == 1
                if dir == 1
                    if na(seqEnd) or p > array.get(majPrices, seqEnd)
                        seqEnd := i
                else if dir == -1
                    bool bullBreak = not na(lastHigh) and p > array.get(majPrices, lastHigh)
                    if bullBreak
                        if not na(seqStart) and not na(seqEnd)
                            float finishedMove = f_movePct(array.get(majPrices, seqStart), array.get(majPrices, seqEnd), -1)
                            if finishedMove >= macroMinMovePct
                                array.push(macroStartIdx, seqStart)
                                array.push(macroEndIdx, seqEnd)
                                array.push(macroDir, -1)
                        seqStart := lastLow
                        seqEnd := i
                        dir := 1
                else
                    bool bullStart = not na(lastHigh) and p > array.get(majPrices, lastHigh) and not na(lastLow)
                    if bullStart
                        seqStart := lastLow
                        seqEnd := i
                        dir := 1
                lastHigh := i

            if t == -1
                if dir == -1
                    if na(seqEnd) or p < array.get(majPrices, seqEnd)
                        seqEnd := i
                else if dir == 1
                    bool bearBreak = not na(lastLow) and p < array.get(majPrices, lastLow)
                    if bearBreak
                        if not na(seqStart) and not na(seqEnd)
                            float finishedMove = f_movePct(array.get(majPrices, seqStart), array.get(majPrices, seqEnd), 1)
                            if finishedMove >= macroMinMovePct
                                array.push(macroStartIdx, seqStart)
                                array.push(macroEndIdx, seqEnd)
                                array.push(macroDir, 1)
                        seqStart := lastHigh
                        seqEnd := i
                        dir := -1
                else
                    bool bearStart = not na(lastLow) and p < array.get(majPrices, lastLow) and not na(lastHigh)
                    if bearStart
                        seqStart := lastHigh
                        seqEnd := i
                        dir := -1
                lastLow := i

        if dir != 0 and not na(seqStart) and not na(seqEnd)
            float liveMove = f_movePct(array.get(majPrices, seqStart), array.get(majPrices, seqEnd), dir)
            if liveMove >= macroMinMovePct
                array.push(macroStartIdx, seqStart)
                array.push(macroEndIdx, seqEnd)
                array.push(macroDir, dir)
    true

ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

if not na(ph)
    int pBar = bar_index - pivotLen
    if bar_index - pBar <= lookbackDays
        f_addPivot(pBar, ph, 1)

if not na(pl)
    int pBar = bar_index - pivotLen
    if bar_index - pBar <= lookbackDays
        f_addPivot(pBar, pl, -1)

if barstate.islast
    f_clearDrawings()
    f_buildMajorSwings()
    f_buildSequences()

    int count = array.size(macroStartIdx)
    int drawn = 0
    if count > 0
        for n = 0 to count - 1
            int k = count - 1 - n
            if drawn < maxMacroImpulses
                int sIdx = array.get(macroStartIdx, k)
                int eIdx = array.get(macroEndIdx, k)
                int dir = array.get(macroDir, k)
                int sBar = array.get(majBars, sIdx)
                int eBar = array.get(majBars, eIdx)
                bool insideLookback = bar_index - sBar <= lookbackDays
                if insideLookback
                    float sPrice = array.get(majPrices, sIdx)
                    float ePrice = array.get(majPrices, eIdx)
                    float move = f_movePct(sPrice, ePrice, dir)
                    string suffix = drawn == 0 ? " latest" : ""
                    f_drawLine(sBar, sPrice, eBar, ePrice, dir, true, move, suffix)
                    f_drawSubMacrosForMacro(sIdx, eIdx, dir, sPrice, ePrice, eBar)
                    drawn += 1
