//@version=6
indicator("Impulse Fib From Rejection v0.2", overlay=true, max_labels_count=80, max_lines_count=80)

// -----------------------------------------------------------------------------
// Impulse Fib From Rejection v0.2
// Fix of previous bad sloped-range experiment.
//
// What this file does now:
// 1) Restores the previous global impulse measurement logic from the 1D map.
// 2) Draws the measured impulse line: impulse start -> impulse rejection point.
// 3) Builds HORIZONTAL Fibonacci levels from the impulse rejection point back
//    toward the impulse start.
//
// No entries, no TP/SL, no automation.
// -----------------------------------------------------------------------------

showDashboard = input.bool(true, "Show dashboard")
showImpulseLine = input.bool(true, "Show impulse measurement")
showImpulseLabels = input.bool(true, "Show impulse labels")
showFibLevels = input.bool(true, "Show horizontal fib levels")
showTouchMarks = input.bool(true, "Show touch marks")

// === Global impulse settings ===
lookbackDays = input.int(244, "Daily lookback", minval=50, maxval=500)
pivotLenD = input.int(5, "1D pivot length", minval=2, maxval=30)
atrLenD = input.int(14, "1D ATR length", minval=1, maxval=100)
minImpulsePct = input.float(15.0, "Min impulse %", minval=1.0, step=0.5)
minImpulseAtr = input.float(5.0, "Min impulse ATR", minval=1.0, step=0.5)
minImpulseBars = input.int(3, "Min daily bars in impulse", minval=1, maxval=60)
minMacroEndPosition = input.float(0.45, "Min macro position for bullish impulse end", minval=0.20, maxval=0.80, step=0.05)
maxMacroEndPosition = input.float(0.55, "Max macro position for bearish impulse end", minval=0.20, maxval=0.80, step=0.05)

// === Fib settings ===
fibNearTolerancePct = input.float(0.0035, "Fib near tolerance, % of impulse", minval=0.0005, maxval=0.02, step=0.0005)

// === Daily global impulse function: restored previous measurement ===
f_dailyImpulse() =>
    atrD = ta.atr(atrLenD)
    ph = ta.pivothigh(high, pivotLenD, pivotLenD)
    pl = ta.pivotlow(low, pivotLenD, pivotLenD)

    macroHigh = ta.highest(high, lookbackDays)
    macroLow = ta.lowest(low, lookbackDays)
    macroMid = (macroHigh + macroLow) / 2.0
    macroSize = macroHigh - macroLow

    var float lastSwingHigh = na
    var float lastSwingLow = na
    var int lastSwingHighBar = na
    var int lastSwingLowBar = na
    var int lastSwingHighTime = na
    var int lastSwingLowTime = na

    var int impulseDir = 0
    var float impulseStart = na
    var float impulseEnd = na
    var int impulseEndBar = na
    var int impulseStartTime = na
    var int impulseEndTime = na
    var float impulsePct = na
    var float impulseAtr = na
    var string rejectionReason = "None"

    if not na(ph)
        phBar = bar_index - pivotLenD
        phTime = time[pivotLenD]
        if not na(lastSwingLow)
            bars = phBar - lastSwingLowBar
            size = ph - lastSwingLow
            pct = lastSwingLow != 0.0 ? size / lastSwingLow * 100.0 : na
            atrs = not na(atrD[pivotLenD]) and atrD[pivotLenD] > 0.0 ? size / atrD[pivotLenD] : na
            endPos = macroSize > 0 ? (ph - macroLow) / macroSize : na
            brokePreviousHigh = na(lastSwingHigh) or ph > lastSwingHigh
            sizeOk = size > 0 and bars >= minImpulseBars and ((not na(pct) and pct >= minImpulsePct) or (not na(atrs) and atrs >= minImpulseAtr))
            macroOk = not na(endPos) and endPos >= minMacroEndPosition
            validBull = sizeOk and brokePreviousHigh and macroOk
            if validBull
                impulseDir := 1
                impulseStart := lastSwingLow
                impulseEnd := ph
                impulseEndBar := phBar
                impulseStartTime := lastSwingLowTime
                impulseEndTime := phTime
                impulsePct := pct
                impulseAtr := atrs
                rejectionReason := "None"
            else if sizeOk and brokePreviousHigh and not macroOk
                rejectionReason := "Bull move rejected: end still low in macro range"
        lastSwingHigh := ph
        lastSwingHighBar := phBar
        lastSwingHighTime := phTime

    if not na(pl)
        plBar = bar_index - pivotLenD
        plTime = time[pivotLenD]
        if not na(lastSwingHigh)
            bars = plBar - lastSwingHighBar
            size = lastSwingHigh - pl
            pct = lastSwingHigh != 0.0 ? size / lastSwingHigh * 100.0 : na
            atrs = not na(atrD[pivotLenD]) and atrD[pivotLenD] > 0.0 ? size / atrD[pivotLenD] : na
            endPos = macroSize > 0 ? (pl - macroLow) / macroSize : na
            brokePreviousLow = na(lastSwingLow) or pl < lastSwingLow
            sizeOk = size > 0 and bars >= minImpulseBars and ((not na(pct) and pct >= minImpulsePct) or (not na(atrs) and atrs >= minImpulseAtr))
            macroOk = not na(endPos) and endPos <= maxMacroEndPosition
            validBear = sizeOk and brokePreviousLow and macroOk
            if validBear
                impulseDir := -1
                impulseStart := lastSwingHigh
                impulseEnd := pl
                impulseEndBar := plBar
                impulseStartTime := lastSwingHighTime
                impulseEndTime := plTime
                impulsePct := pct
                impulseAtr := atrs
                rejectionReason := "None"
            else if sizeOk and brokePreviousLow and not macroOk
                rejectionReason := "Bear move rejected: end still high in macro range"
        lastSwingLow := pl
        lastSwingLowBar := plBar
        lastSwingLowTime := plTime

    impulseAge = not na(impulseEndBar) ? bar_index - impulseEndBar : na
    impulseIsRecent = not na(impulseAge) and impulseAge <= lookbackDays
    activeDir = impulseIsRecent ? impulseDir : 0

    [activeDir, impulseStart, impulseEnd, impulseStartTime, impulseEndTime, impulsePct, impulseAtr, macroHigh, macroLow, macroMid, rejectionReason]

[globalDir, impulseStart, impulseEnd, impulseStartTime, impulseEndTime, impulsePct, impulseAtr, macroHigh, macroLow, macroMid, rejectionReason] = request.security(syminfo.tickerid, "D", f_dailyImpulse(), barmerge.gaps_off, barmerge.lookahead_off)

// === Horizontal fib from impulse rejection point ===
// Rejection point = impulseEnd.
// Fib is built from impulseEnd back toward impulseStart.
impulseSizeAbs = not na(impulseStart) and not na(impulseEnd) ? math.abs(impulseStart - impulseEnd) : na
fibValid = showFibLevels and globalDir != 0 and not na(impulseSizeAbs) and impulseSizeAbs > 0
fibBase = impulseEnd
fibTarget = impulseStart

f_fib(r) =>
    fibValid ? fibBase + (fibTarget - fibBase) * r : na

fib000 = f_fib(0.0)
fib236 = f_fib(0.236)
fib382 = f_fib(0.382)
fib500 = f_fib(0.5)
fib618 = f_fib(0.618)
fib700 = f_fib(0.7)
fib786 = f_fib(0.786)
fib886 = f_fib(0.886)
fib100 = f_fib(1.0)

tolPrice = fibValid ? impulseSizeAbs * fibNearTolerancePct : na

f_dist(level) =>
    math.abs(close - level)

float nearestFib = na
string nearestFibName = "na"
float nearestDist = na
if fibValid
    nearestFib := fib000
    nearestFibName := "0"
    nearestDist := f_dist(fib000)
    if f_dist(fib236) < nearestDist
        nearestFib := fib236
        nearestFibName := "0.236"
        nearestDist := f_dist(fib236)
    if f_dist(fib382) < nearestDist
        nearestFib := fib382
        nearestFibName := "0.382"
        nearestDist := f_dist(fib382)
    if f_dist(fib500) < nearestDist
        nearestFib := fib500
        nearestFibName := "0.5"
        nearestDist := f_dist(fib500)
    if f_dist(fib618) < nearestDist
        nearestFib := fib618
        nearestFibName := "0.618"
        nearestDist := f_dist(fib618)
    if f_dist(fib700) < nearestDist
        nearestFib := fib700
        nearestFibName := "0.7"
        nearestDist := f_dist(fib700)
    if f_dist(fib786) < nearestDist
        nearestFib := fib786
        nearestFibName := "0.786"
        nearestDist := f_dist(fib786)
    if f_dist(fib886) < nearestDist
        nearestFib := fib886
        nearestFibName := "0.886"
        nearestDist := f_dist(fib886)
    if f_dist(fib100) < nearestDist
        nearestFib := fib100
        nearestFibName := "1"
        nearestDist := f_dist(fib100)

nearNearestFib = fibValid and not na(nearestFib) and nearestDist <= tolPrice
touchedNearestFib = fibValid and not na(nearestFib) and low <= nearestFib and high >= nearestFib
wickPiercedNearestFib = fibValid and not na(nearestFib) and ((low < nearestFib and close > nearestFib) or (high > nearestFib and close < nearestFib))

// === Context text ===
lastImpulseText = globalDir == 1 ? "LAST GLOBAL IMPULSE UP" : globalDir == -1 ? "LAST GLOBAL IMPULSE DOWN" : "NO VALID GLOBAL IMPULSE"
dirText = globalDir == 1 ? "UP" : globalDir == -1 ? "DOWN" : "NONE"
anchorText = globalDir == -1 ? "bear impulse low / rejection" : globalDir == 1 ? "bull impulse high / rejection" : "na"

// === Plots: macro context ===
plot(macroHigh, "244D Macro Range High", color=color.new(color.red, 70), linewidth=1, style=plot.style_linebr)
plot(macroLow, "244D Macro Range Low", color=color.new(color.lime, 70), linewidth=1, style=plot.style_linebr)
plot(macroMid, "244D Macro Range Mid", color=color.new(color.gray, 75), linewidth=1, style=plot.style_linebr)

// === Plots: horizontal fibs ===
plot(fib000, "Fib 0 rejection", color=color.new(color.white, 20), linewidth=2, style=plot.style_linebr)
plot(fib236, "Fib 0.236", color=color.new(color.white, 65), linewidth=1, style=plot.style_linebr)
plot(fib382, "Fib 0.382", color=color.new(color.white, 55), linewidth=1, style=plot.style_linebr)
plot(fib500, "Fib 0.5", color=color.new(color.white, 45), linewidth=1, style=plot.style_linebr)
plot(fib618, "Fib 0.618", color=color.new(color.yellow, 30), linewidth=1, style=plot.style_linebr)
plot(fib700, "Fib 0.7", color=color.new(color.yellow, 20), linewidth=1, style=plot.style_linebr)
plot(fib786, "Fib 0.786", color=color.new(color.orange, 10), linewidth=2, style=plot.style_linebr)
plot(fib886, "Fib 0.886", color=color.new(color.red, 5), linewidth=2, style=plot.style_linebr)
plot(fib100, "Fib 1 impulse start", color=color.new(color.white, 30), linewidth=1, style=plot.style_linebr)

plotshape(showTouchMarks and touchedNearestFib, title="Nearest fib touched", style=shape.circle, location=location.abovebar, size=size.tiny, color=color.new(color.yellow, 0), text="fib")
plotshape(showTouchMarks and wickPiercedNearestFib, title="Nearest fib pierced/reclaimed", style=shape.triangleup, location=location.belowbar, size=size.tiny, color=color.new(color.lime, 0), text="re")

// === Impulse measurement line ===
var line impulseLine = na
var label startLabel = na
var label endLabel = na

if barstate.islast and showImpulseLine and globalDir != 0 and not na(impulseStartTime) and not na(impulseEndTime)
    if na(impulseLine)
        impulseLine := line.new(impulseStartTime, impulseStart, impulseEndTime, impulseEnd, xloc=xloc.bar_time, color=globalDir == 1 ? color.lime : color.red, width=3)
    else
        line.set_xy1(impulseLine, impulseStartTime, impulseStart)
        line.set_xy2(impulseLine, impulseEndTime, impulseEnd)
        line.set_color(impulseLine, globalDir == 1 ? color.lime : color.red)
        line.set_width(impulseLine, 3)

if barstate.islast and showImpulseLabels and globalDir != 0 and not na(impulseStartTime) and not na(impulseEndTime)
    label.delete(startLabel)
    label.delete(endLabel)
    startLabel := label.new(impulseStartTime, impulseStart, "Impulse Start\n" + str.tostring(impulseStart, format.mintick), xloc=xloc.bar_time, style=globalDir == 1 ? label.style_label_up : label.style_label_down, color=color.new(color.blue, 0), textcolor=color.white, size=size.small)
    endLabel := label.new(impulseEndTime, impulseEnd, "Impulse Rejection\n" + str.tostring(impulseEnd, format.mintick), xloc=xloc.bar_time, style=globalDir == 1 ? label.style_label_down : label.style_label_up, color=globalDir == 1 ? color.new(color.lime, 0) : color.new(color.red, 0), textcolor=color.white, size=size.small)

// === Dashboard ===
var table dash = table.new(position.top_right, 2, 15, border_width=1)
if showDashboard and barstate.islast
    table.clear(dash, 0, 0, 1, 14)
    table.cell(dash, 0, 0, "Version", text_color=color.white, bgcolor=color.black)
    table.cell(dash, 1, 0, "Impulse Fib From Rejection v0.2", text_color=color.white, bgcolor=color.black)
    table.cell(dash, 0, 1, "Last impulse", text_color=color.white)
    table.cell(dash, 1, 1, lastImpulseText, text_color=color.white)
    table.cell(dash, 0, 2, "Direction", text_color=color.white)
    table.cell(dash, 1, 2, dirText, text_color=color.white)
    table.cell(dash, 0, 3, "Impulse Start", text_color=color.white)
    table.cell(dash, 1, 3, globalDir == 0 ? "na" : str.tostring(impulseStart, format.mintick), text_color=color.white)
    table.cell(dash, 0, 4, "Impulse Rejection", text_color=color.white)
    table.cell(dash, 1, 4, globalDir == 0 ? "na" : str.tostring(impulseEnd, format.mintick), text_color=color.white)
    table.cell(dash, 0, 5, "Anchor", text_color=color.white)
    table.cell(dash, 1, 5, anchorText, text_color=color.white)
    table.cell(dash, 0, 6, "Size % / ATR", text_color=color.white)
    table.cell(dash, 1, 6, globalDir == 0 ? "na" : str.tostring(impulsePct, "#.##") + "% / " + str.tostring(impulseAtr, "#.##"), text_color=color.white)
    table.cell(dash, 0, 7, "Nearest fib", text_color=color.white)
    table.cell(dash, 1, 7, nearestFibName + " / " + str.tostring(nearestFib, format.mintick), text_color=color.white)
    table.cell(dash, 0, 8, "Near?", text_color=color.white)
    table.cell(dash, 1, 8, nearNearestFib ? "YES" : "NO", text_color=color.white)
    table.cell(dash, 0, 9, "Touched?", text_color=color.white)
    table.cell(dash, 1, 9, touchedNearestFib ? "YES" : "NO", text_color=color.white)
    table.cell(dash, 0, 10, "Pierced/reclaimed?", text_color=color.white)
    table.cell(dash, 1, 10, wickPiercedNearestFib ? "YES" : "NO", text_color=color.white)
    table.cell(dash, 0, 11, "0.786", text_color=color.white)
    table.cell(dash, 1, 11, str.tostring(fib786, format.mintick), text_color=color.white)
    table.cell(dash, 0, 12, "0.886", text_color=color.white)
    table.cell(dash, 1, 12, str.tostring(fib886, format.mintick), text_color=color.white)
    table.cell(dash, 0, 13, "Macro H/L", text_color=color.white)
    table.cell(dash, 1, 13, str.tostring(macroHigh, format.mintick) + " / " + str.tostring(macroLow, format.mintick), text_color=color.white)
    table.cell(dash, 0, 14, "Rejected candidate", text_color=color.white)
    table.cell(dash, 1, 14, rejectionReason, text_color=color.white)
