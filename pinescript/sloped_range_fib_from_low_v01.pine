//@version=6
indicator("G/R/L Fixed Fib Levels v0.7", overlay=true, max_labels_count=160, max_lines_count=160)

// G/R/L Fixed Fib Levels v0.7
// Fib set: 0 / 0.236 / 0.382 / 0.5 / 0.618 / 0.7 / 0.786 / 0.88 / 0.886 / 1
// G = global fib: full big 1D impulse, impulse rejection -> impulse start.
// R = range fib: current range boundaries from a rolling lookback, not max recovery.
// L = local fib: latest local chart-timeframe impulse.
// All fib levels are drawn as fixed horizontal lines with text-only labels above the line.

showG = input.bool(true, "Show G - global fib")
showR = input.bool(true, "Show R - range fib")
showL = input.bool(false, "Show L - latest local impulse fib")
showDashboard = input.bool(false, "Show dashboard")
showImpulseLine = input.bool(true, "Show global impulse measurement")
showImpulseLabels = input.bool(false, "Show impulse labels")

lookbackDays = input.int(244, "Daily lookback", minval=50, maxval=500)
pivotLenD = input.int(5, "1D pivot length", minval=2, maxval=30)
atrLenD = input.int(14, "1D ATR length", minval=1, maxval=100)
minImpulsePct = input.float(15.0, "Min global impulse %", minval=1.0, step=0.5)
minImpulseAtr = input.float(5.0, "Min global impulse ATR", minval=1.0, step=0.5)
minImpulseBars = input.int(3, "Min daily bars in global impulse", minval=1, maxval=60)
minMacroEndPosition = input.float(0.45, "Min macro position for bullish impulse end", minval=0.20, maxval=0.80, step=0.05)
maxMacroEndPosition = input.float(0.55, "Max macro position for bearish impulse end", minval=0.20, maxval=0.80, step=0.05)

rangeLookbackBars = input.int(80, "R range lookback bars", minval=20, maxval=1500)
rangeUseImpulseLowAsFloor = input.bool(false, "R low cannot be above global impulse rejection")

localPivotLen = input.int(4, "Local pivot length", minval=2, maxval=30)
localAtrLen = input.int(14, "Local ATR length", minval=1, maxval=100)
minLocalImpulsePct = input.float(1.2, "Min local impulse %", minval=0.1, step=0.1)
minLocalImpulseAtr = input.float(2.0, "Min local impulse ATR", minval=0.2, step=0.2)

lineBackBars = input.int(260, "Fib line starts N bars back", minval=10, maxval=5000)
lineForwardBars = input.int(260, "Fib line extends N bars forward", minval=20, maxval=5000)
labelOffsetBars = input.int(12, "Fib label offset bars", minval=1, maxval=500)
labelYOffsetTicks = input.int(18, "Label vertical offset, ticks", minval=0, maxval=500)

// === Global impulse from 1D ===
f_dailyImpulse() =>
    atrD = ta.atr(atrLenD)
    ph = ta.pivothigh(high, pivotLenD, pivotLenD)
    pl = ta.pivotlow(low, pivotLenD, pivotLenD)
    macroHigh = ta.highest(high, lookbackDays)
    macroLow = ta.lowest(low, lookbackDays)
    macroMid = (macroHigh + macroLow) / 2.0
    macroSize = macroHigh - macroLow

    var float lastSwingHigh = na
    var float lastSwingLow = na
    var int lastSwingHighBar = na
    var int lastSwingLowBar = na
    var int lastSwingHighTime = na
    var int lastSwingLowTime = na
    var int impulseDir = 0
    var float impulseStart = na
    var float impulseEnd = na
    var int impulseEndBar = na
    var int impulseStartTime = na
    var int impulseEndTime = na
    var float impulsePct = na
    var float impulseAtr = na
    var string rejectionReason = "None"

    if not na(ph)
        phBar = bar_index - pivotLenD
        phTime = time[pivotLenD]
        if not na(lastSwingLow)
            bars = phBar - lastSwingLowBar
            size = ph - lastSwingLow
            pct = lastSwingLow != 0.0 ? size / lastSwingLow * 100.0 : na
            atrs = not na(atrD[pivotLenD]) and atrD[pivotLenD] > 0.0 ? size / atrD[pivotLenD] : na
            endPos = macroSize > 0 ? (ph - macroLow) / macroSize : na
            brokePreviousHigh = na(lastSwingHigh) or ph > lastSwingHigh
            sizeOk = size > 0 and bars >= minImpulseBars and ((not na(pct) and pct >= minImpulsePct) or (not na(atrs) and atrs >= minImpulseAtr))
            macroOk = not na(endPos) and endPos >= minMacroEndPosition
            if sizeOk and brokePreviousHigh and macroOk
                impulseDir := 1
                impulseStart := lastSwingLow
                impulseEnd := ph
                impulseEndBar := phBar
                impulseStartTime := lastSwingLowTime
                impulseEndTime := phTime
                impulsePct := pct
                impulseAtr := atrs
                rejectionReason := "None"
            else if sizeOk and brokePreviousHigh and not macroOk
                rejectionReason := "Bull move rejected: end still low in macro range"
        lastSwingHigh := ph
        lastSwingHighBar := phBar
        lastSwingHighTime := phTime

    if not na(pl)
        plBar = bar_index - pivotLenD
        plTime = time[pivotLenD]
        if not na(lastSwingHigh)
            bars = plBar - lastSwingHighBar
            size = lastSwingHigh - pl
            pct = lastSwingHigh != 0.0 ? size / lastSwingHigh * 100.0 : na
            atrs = not na(atrD[pivotLenD]) and atrD[pivotLenD] > 0.0 ? size / atrD[pivotLenD] : na
            endPos = macroSize > 0 ? (pl - macroLow) / macroSize : na
            brokePreviousLow = na(lastSwingLow) or pl < lastSwingLow
            sizeOk = size > 0 and bars >= minImpulseBars and ((not na(pct) and pct >= minImpulsePct) or (not na(atrs) and atrs >= minImpulseAtr))
            macroOk = not na(endPos) and endPos <= maxMacroEndPosition
            if sizeOk and brokePreviousLow and macroOk
                impulseDir := -1
                impulseStart := lastSwingHigh
                impulseEnd := pl
                impulseEndBar := plBar
                impulseStartTime := lastSwingHighTime
                impulseEndTime := plTime
                impulsePct := pct
                impulseAtr := atrs
                rejectionReason := "None"
            else if sizeOk and brokePreviousLow and not macroOk
                rejectionReason := "Bear move rejected: end still high in macro range"
        lastSwingLow := pl
        lastSwingLowBar := plBar
        lastSwingLowTime := plTime

    impulseAge = not na(impulseEndBar) ? bar_index - impulseEndBar : na
    impulseIsRecent = not na(impulseAge) and impulseAge <= lookbackDays
    activeDir = impulseIsRecent ? impulseDir : 0
    [activeDir, impulseStart, impulseEnd, impulseStartTime, impulseEndTime, impulsePct, impulseAtr, macroHigh, macroLow, macroMid, rejectionReason]

[globalDir, impulseStart, impulseEnd, impulseStartTime, impulseEndTime, impulsePct, impulseAtr, macroHigh, macroLow, macroMid, rejectionReason] = request.security(syminfo.tickerid, "D", f_dailyImpulse(), barmerge.gaps_off, barmerge.lookahead_off)

f_level(base, target, ratio, isValid) => isValid ? base + (target - base) * ratio : na

// === G fib: big global impulse ===
gSize = not na(impulseStart) and not na(impulseEnd) ? math.abs(impulseStart - impulseEnd) : na
gValid = showG and globalDir != 0 and not na(gSize) and gSize > 0
gBase = impulseEnd
gTarget = impulseStart
g0 = f_level(gBase, gTarget, 0.0, gValid)
g236 = f_level(gBase, gTarget, 0.236, gValid)
g382 = f_level(gBase, gTarget, 0.382, gValid)
g500 = f_level(gBase, gTarget, 0.5, gValid)
g618 = f_level(gBase, gTarget, 0.618, gValid)
g700 = f_level(gBase, gTarget, 0.7, gValid)
g786 = f_level(gBase, gTarget, 0.786, gValid)
g880 = f_level(gBase, gTarget, 0.88, gValid)
g886 = f_level(gBase, gTarget, 0.886, gValid)
g1 = f_level(gBase, gTarget, 1.0, gValid)

// === R fib: current range boundaries, fixed on current calculation ===
rollingHigh = ta.highest(high, rangeLookbackBars)
rollingLow = ta.lowest(low, rangeLookbackBars)
rLowCandidate = rangeUseImpulseLowAsFloor and globalDir == -1 and not na(impulseEnd) ? math.min(rollingLow, impulseEnd) : rollingLow
rHighCandidate = rangeUseImpulseLowAsFloor and globalDir == 1 and not na(impulseEnd) ? math.max(rollingHigh, impulseEnd) : rollingHigh
rBase = globalDir == 1 ? rHighCandidate : rLowCandidate
rTarget = globalDir == 1 ? rLowCandidate : rHighCandidate
rSize = not na(rBase) and not na(rTarget) ? math.abs(rTarget - rBase) : na
rValid = showR and globalDir != 0 and not na(rSize) and rSize > syminfo.mintick
r0 = f_level(rBase, rTarget, 0.0, rValid)
r236 = f_level(rBase, rTarget, 0.236, rValid)
r382 = f_level(rBase, rTarget, 0.382, rValid)
r500 = f_level(rBase, rTarget, 0.5, rValid)
r618 = f_level(rBase, rTarget, 0.618, rValid)
r700 = f_level(rBase, rTarget, 0.7, rValid)
r786 = f_level(rBase, rTarget, 0.786, rValid)
r880 = f_level(rBase, rTarget, 0.88, rValid)
r886 = f_level(rBase, rTarget, 0.886, rValid)
r1 = f_level(rBase, rTarget, 1.0, rValid)

// === L fib: latest local impulse on current chart timeframe ===
atrLocal = ta.atr(localAtrLen)
phL = ta.pivothigh(high, localPivotLen, localPivotLen)
plL = ta.pivotlow(low, localPivotLen, localPivotLen)
var float lastLocalHigh = na
var float lastLocalLow = na
var int lastLocalHighTime = na
var int lastLocalLowTime = na
var int lDir = 0
var float lStart = na
var float lEnd = na
var int lStartTime = na
var int lEndTime = na

if not na(phL)
    phTime = time[localPivotLen]
    if not na(lastLocalLow)
        size = phL - lastLocalLow
        pct = lastLocalLow != 0.0 ? size / lastLocalLow * 100.0 : na
        atrs = not na(atrLocal[localPivotLen]) and atrLocal[localPivotLen] > 0.0 ? size / atrLocal[localPivotLen] : na
        if size > 0 and ((not na(pct) and pct >= minLocalImpulsePct) or (not na(atrs) and atrs >= minLocalImpulseAtr))
            lDir := 1
            lStart := lastLocalLow
            lEnd := phL
            lStartTime := lastLocalLowTime
            lEndTime := phTime
    lastLocalHigh := phL
    lastLocalHighTime := phTime

if not na(plL)
    plTime = time[localPivotLen]
    if not na(lastLocalHigh)
        size = lastLocalHigh - plL
        pct = lastLocalHigh != 0.0 ? size / lastLocalHigh * 100.0 : na
        atrs = not na(atrLocal[localPivotLen]) and atrLocal[localPivotLen] > 0.0 ? size / atrLocal[localPivotLen] : na
        if size > 0 and ((not na(pct) and pct >= minLocalImpulsePct) or (not na(atrs) and atrs >= minLocalImpulseAtr))
            lDir := -1
            lStart := lastLocalHigh
            lEnd := plL
            lStartTime := lastLocalHighTime
            lEndTime := plTime
    lastLocalLow := plL
    lastLocalLowTime := plTime

lSize = not na(lStart) and not na(lEnd) ? math.abs(lStart - lEnd) : na
lValid = showL and lDir != 0 and not na(lSize) and lSize > syminfo.mintick
lBase = lEnd
lTarget = lStart
l0 = f_level(lBase, lTarget, 0.0, lValid)
l236 = f_level(lBase, lTarget, 0.236, lValid)
l382 = f_level(lBase, lTarget, 0.382, lValid)
l500 = f_level(lBase, lTarget, 0.5, lValid)
l618 = f_level(lBase, lTarget, 0.618, lValid)
l700 = f_level(lBase, lTarget, 0.7, lValid)
l786 = f_level(lBase, lTarget, 0.786, lValid)
l880 = f_level(lBase, lTarget, 0.88, lValid)
l886 = f_level(lBase, lTarget, 0.886, lValid)
l1 = f_level(lBase, lTarget, 1.0, lValid)

// === Only macro context may use plot. Fib levels below are NOT plot() series. ===
plot(macroHigh, "244D Macro Range High", color=color.new(color.red, 88), linewidth=1, style=plot.style_linebr)
plot(macroLow, "244D Macro Range Low", color=color.new(color.lime, 88), linewidth=1, style=plot.style_linebr)
plot(macroMid, "244D Macro Range Mid", color=color.new(color.gray, 90), linewidth=1, style=plot.style_linebr)

// === Horizontal TV-style fib lines and text labels ===
var line[] fibLines = array.new_line()
var label[] fibLabels = array.new_label()

f_clearDrawings() =>
    while array.size(fibLines) > 0
        line.delete(array.pop(fibLines))
    while array.size(fibLabels) > 0
        label.delete(array.pop(fibLabels))

f_drawLevel(_prefix, _ratioText, _price, _isValid, _lineColor, _textColor, _width) =>
    if _isValid and not na(_price)
        x1 = bar_index - lineBackBars
        x2 = bar_index + lineForwardBars
        l = line.new(x1, _price, x2, _price, xloc=xloc.bar_index, extend=extend.right, color=_lineColor, width=_width)
        array.push(fibLines, l)
        yOffset = syminfo.mintick * labelYOffsetTicks
        txt = _prefix + " " + _ratioText + " (" + str.tostring(_price, format.mintick) + ")"
        lab = label.new(bar_index + labelOffsetBars, _price + yOffset, txt, xloc=xloc.bar_index, style=label.style_none, textcolor=_textColor, color=color.new(color.white, 100), size=size.small)
        array.push(fibLabels, lab)

if barstate.islast
    f_clearDrawings()

    // G = darker / background context
    f_drawLevel("G", "0", g0, gValid, color.new(color.white, 55), color.new(color.white, 20), 1)
    f_drawLevel("G", "0.236", g236, gValid, color.new(color.red, 65), color.new(color.red, 20), 1)
    f_drawLevel("G", "0.382", g382, gValid, color.new(color.orange, 65), color.new(color.orange, 20), 1)
    f_drawLevel("G", "0.5", g500, gValid, color.new(color.white, 65), color.new(color.white, 20), 1)
    f_drawLevel("G", "0.618", g618, gValid, color.new(color.green, 65), color.new(color.green, 20), 1)
    f_drawLevel("G", "0.7", g700, gValid, color.new(color.yellow, 60), color.new(color.yellow, 20), 1)
    f_drawLevel("G", "0.786", g786, gValid, color.new(color.aqua, 58), color.new(color.aqua, 20), 1)
    f_drawLevel("G", "0.88", g880, gValid, color.new(color.fuchsia, 58), color.new(color.fuchsia, 20), 1)
    f_drawLevel("G", "0.886", g886, gValid, color.new(color.red, 58), color.new(color.red, 20), 1)
    f_drawLevel("G", "1", g1, gValid, color.new(color.white, 55), color.new(color.white, 20), 1)

    // R = medium strength range context
    f_drawLevel("R", "0", r0, rValid, color.new(color.white, 25), color.white, 2)
    f_drawLevel("R", "0.236", r236, rValid, color.new(color.red, 40), color.red, 1)
    f_drawLevel("R", "0.382", r382, rValid, color.new(color.orange, 25), color.orange, 1)
    f_drawLevel("R", "0.5", r500, rValid, color.new(color.white, 35), color.white, 1)
    f_drawLevel("R", "0.618", r618, rValid, color.new(color.green, 25), color.green, 1)
    f_drawLevel("R", "0.7", r700, rValid, color.new(color.yellow, 18), color.yellow, 1)
    f_drawLevel("R", "0.786", r786, rValid, color.new(color.aqua, 15), color.aqua, 1)
    f_drawLevel("R", "0.88", r880, rValid, color.new(color.fuchsia, 15), color.fuchsia, 1)
    f_drawLevel("R", "0.886", r886, rValid, color.new(color.red, 15), color.red, 1)
    f_drawLevel("R", "1", r1, rValid, color.new(color.white, 25), color.white, 2)

    // L = bright local context
    f_drawLevel("L", "0", l0, lValid, color.new(color.white, 5), color.white, 2)
    f_drawLevel("L", "0.236", l236, lValid, color.new(color.red, 5), color.red, 1)
    f_drawLevel("L", "0.382", l382, lValid, color.new(color.orange, 0), color.orange, 1)
    f_drawLevel("L", "0.5", l500, lValid, color.new(color.white, 5), color.white, 1)
    f_drawLevel("L", "0.618", l618, lValid, color.new(color.green, 0), color.green, 1)
    f_drawLevel("L", "0.7", l700, lValid, color.new(color.yellow, 0), color.yellow, 1)
    f_drawLevel("L", "0.786", l786, lValid, color.new(color.aqua, 0), color.aqua, 2)
    f_drawLevel("L", "0.88", l880, lValid, color.new(color.fuchsia, 0), color.fuchsia, 2)
    f_drawLevel("L", "0.886", l886, lValid, color.new(color.red, 0), color.red, 2)
    f_drawLevel("L", "1", l1, lValid, color.new(color.white, 0), color.white, 2)

// === Global impulse measurement line ===
var line impulseLine = na
var label startLabel = na
var label endLabel = na
if barstate.islast and showImpulseLine and globalDir != 0 and not na(impulseStartTime) and not na(impulseEndTime)
    if na(impulseLine)
        impulseLine := line.new(impulseStartTime, impulseStart, impulseEndTime, impulseEnd, xloc=xloc.bar_time, color=globalDir == 1 ? color.lime : color.red, width=3)
    else
        line.set_xy1(impulseLine, impulseStartTime, impulseStart)
        line.set_xy2(impulseLine, impulseEndTime, impulseEnd)
        line.set_color(impulseLine, globalDir == 1 ? color.lime : color.red)
        line.set_width(impulseLine, 3)

if barstate.islast and showImpulseLabels and globalDir != 0 and not na(impulseStartTime) and not na(impulseEndTime)
    label.delete(startLabel)
    label.delete(endLabel)
    startLabel := label.new(impulseStartTime, impulseStart, "Impulse Start\n" + str.tostring(impulseStart, format.mintick), xloc=xloc.bar_time, style=globalDir == 1 ? label.style_label_up : label.style_label_down, color=color.new(color.blue, 0), textcolor=color.white, size=size.small)
    endLabel := label.new(impulseEndTime, impulseEnd, "Impulse Rejection\n" + str.tostring(impulseEnd, format.mintick), xloc=xloc.bar_time, style=globalDir == 1 ? label.style_label_down : label.style_label_up, color=globalDir == 1 ? color.new(color.lime, 0) : color.new(color.red, 0), textcolor=color.white, size=size.small)

// === Dashboard ===
var table dash = table.new(position.top_right, 2, 12, border_width=1)
if showDashboard and barstate.islast
    table.clear(dash, 0, 0, 1, 11)
    table.cell(dash, 0, 0, "Version", text_color=color.white, bgcolor=color.black)
    table.cell(dash, 1, 0, "G/R/L Fixed Fib v0.7", text_color=color.white, bgcolor=color.black)
    table.cell(dash, 0, 1, "Fib mode", text_color=color.white)
    table.cell(dash, 1, 1, "fixed horizontal lines", text_color=color.white)
    table.cell(dash, 0, 2, "G", text_color=color.white)
    table.cell(dash, 1, 2, gValid ? str.tostring(g0, format.mintick) + " → " + str.tostring(g1, format.mintick) : "na", text_color=color.white)
    table.cell(dash, 0, 3, "R", text_color=color.white)
    table.cell(dash, 1, 3, rValid ? str.tostring(r0, format.mintick) + " → " + str.tostring(r1, format.mintick) : "na", text_color=color.white)
    table.cell(dash, 0, 4, "R source", text_color=color.white)
    table.cell(dash, 1, 4, "rolling " + str.tostring(rangeLookbackBars) + " bars", text_color=color.white)
    table.cell(dash, 0, 5, "L", text_color=color.white)
    table.cell(dash, 1, 5, lValid ? str.tostring(l0, format.mintick) + " → " + str.tostring(l1, format.mintick) : "na", text_color=color.white)
    table.cell(dash, 0, 6, "Impulse", text_color=color.white)
    table.cell(dash, 1, 6, globalDir == 1 ? "UP" : globalDir == -1 ? "DOWN" : "NONE", text_color=color.white)
    table.cell(dash, 0, 7, "Impulse start", text_color=color.white)
    table.cell(dash, 1, 7, globalDir == 0 ? "na" : str.tostring(impulseStart, format.mintick), text_color=color.white)
    table.cell(dash, 0, 8, "Impulse rejection", text_color=color.white)
    table.cell(dash, 1, 8, globalDir == 0 ? "na" : str.tostring(impulseEnd, format.mintick), text_color=color.white)
    table.cell(dash, 0, 9, "Size % / ATR", text_color=color.white)
    table.cell(dash, 1, 9, globalDir == 0 ? "na" : str.tostring(impulsePct, "#.##") + "% / " + str.tostring(impulseAtr, "#.##"), text_color=color.white)
    table.cell(dash, 0, 10, "R note", text_color=color.white)
    table.cell(dash, 1, 10, "NOT max recovery high", text_color=color.white)
    table.cell(dash, 0, 11, "Rejected", text_color=color.white)
    table.cell(dash, 1, 11, rejectionReason, text_color=color.white)
