{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "BACKTESTER_V3A_DATA_MANIFEST_V1",
  "title": "Backtester V3-A explicit data manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "format",
    "data_path",
    "data_sha256",
    "columns",
    "row_count"
  ],
  "properties": {
    "schema_version": {
      "const": "BACKTESTER_V3A_DATA_MANIFEST_V1"
    },
    "role": {
      "enum": ["trade_price", "funding", "mark_price"]
    },
    "format": {
      "const": "csv"
    },
    "data_path": {
      "type": "string",
      "minLength": 1
    },
    "data_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "row_count": {
      "type": "integer",
      "minimum": 0
    }
  }
}
