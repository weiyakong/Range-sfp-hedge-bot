{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate_registry.schema.json",
  "title": "Candidate Registry V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "status", "universe_definition", "intake_required_before_substantive_review", "candidates", "variants"],
  "properties": {
    "schema_version": {"const": "CANDIDATE_REGISTRY_V1"},
    "registry_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["DRAFT", "FROZEN"]},
    "universe_definition": {"type": "string", "minLength": 1},
    "intake_required_before_substantive_review": {"const": true},
    "candidates": {"type": "array", "items": {"type": "object"}},
    "variants": {"type": "array", "items": {"type": "object"}}
  }
}
