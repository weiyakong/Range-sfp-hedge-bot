{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "freeze_receipt.schema.json",
  "title": "Strategy Freeze Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "strategy_id", "strategy_version", "candidate_id",
    "variant_id", "frozen_at_utc", "git_commit", "strategy_spec_sha256",
    "candidate_registry", "evaluation_protocol", "engine_capability_manifest_sha256",
    "backtester_commit", "data_manifest_sha256", "strategy_code_sha256",
    "computed_fidelity_classification", "validation", "unresolved_counts"
  ],
  "properties": {
    "schema_version": {"const": "FREEZE_RECEIPT_V1"},
    "strategy_id": {"type": "string", "minLength": 1},
    "strategy_version": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "variant_id": {"type": "string", "minLength": 1},
    "frozen_at_utc": {"type": "string", "format": "date-time"},
    "git_commit": {"type": "string", "minLength": 7},
    "strategy_spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_registry": {"type": "object"},
    "evaluation_protocol": {"type": "object"},
    "engine_capability_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "backtester_commit": {"type": "string", "minLength": 7},
    "data_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strategy_code_sha256": {"type": ["string", "null"]},
    "computed_fidelity_classification": {"enum": ["PURE_REPLICATION", "TRANSFER_REPLICATION", "ADAPTED"]},
    "validation": {"type": "object"},
    "unresolved_counts": {"type": "object"}
  }
}
