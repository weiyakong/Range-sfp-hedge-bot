{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run_receipt.schema.json",
  "title": "Strategy Production Run Receipt V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "candidate_id", "variant_id", "spec_sha256",
    "registry", "protocol", "strategy_code_sha256", "backtester_commit",
    "capability_manifest_sha256", "config_sha256", "data_manifest_sha256",
    "output_manifest_sha256", "tested_start", "tested_end", "run_qa_status",
    "fidelity_classification", "comparability_class", "created_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "RUN_RECEIPT_V1"},
    "run_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "variant_id": {"type": "string", "minLength": 1},
    "spec_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registry": {"type": "object"},
    "protocol": {"type": "object"},
    "strategy_code_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "backtester_commit": {"type": "string", "minLength": 7},
    "capability_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "data_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tested_start": {"type": "integer"},
    "tested_end": {"type": "integer"},
    "run_qa_status": {"type": "string"},
    "fidelity_classification": {"enum": ["PURE_REPLICATION", "TRANSFER_REPLICATION", "ADAPTED"]},
    "comparability_class": {"enum": ["DIRECTLY_COMPARABLE", "COMPARABLE_WITH_DECLARED_EXECUTION_EXCEPTION", "NOT_DIRECTLY_COMPARABLE"]},
    "created_at_utc": {"type": "string", "format": "date-time"}
  }
}
