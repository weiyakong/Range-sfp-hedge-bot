//@version=6
indicator("SFP Candidate Debug v0.2", overlay=true, max_lines_count=500, max_labels_count=200)

// Diagnostic only: raw swing -> Candidate after 700+ USD move -> sweep -> SFP confirmed / broken.
// No entries, SL, TP, strategy orders, webhooks, or live trading.

showDashboard = input.bool(true, "Show dashboard")
showCandidateLabels = input.bool(true, "Show Candidate labels")
showSweepLabels = input.bool(true, "Show Sweep labels")
showSfpLabels = input.bool(true, "Show SFP confirmed labels")
showBrokenLabels = input.bool(true, "Show Broken labels")
showPastLevels = input.bool(false, "Show used/broken levels")

useCurrentTfSwings = input.bool(true, "Use current TF swings")
use1HSwings = input.bool(true, "Use 1H swings")
use4HSwings = input.bool(true, "Use 4H swings")
useDwmBodyReference = input.bool(true, "Show D/W/M body reference levels")

currentTfPivotLen = input.int(5, "Current TF pivot length", minval=2, maxval=40)
htfPivotLen = input.int(3, "HTF pivot length", minval=2, maxval=20)
minMoveUsd = input.float(700.0, "Minimum move from raw swing to become Candidate", minval=0.0, step=50.0)
mergeUsd = input.float(120.0, "Merge nearby Candidate levels USD", minval=0.0, step=10.0)
cleanBreakUsdBuffer = input.float(120.0, "Clean break buffer USD", minval=0.0, step=10.0)
maxImmediateReclaimBars = input.int(1, "Immediate reclaim window bars", minval=0, maxval=2)
maxRawSwings = input.int(160, "Max raw swings stored", minval=20, maxval=400)
maxCandidates = input.int(120, "Max Candidate levels stored", minval=20, maxval=300)
maxLabels = input.int(120, "Max visible labels", minval=20, maxval=200)

var float[] rawPrice = array.new<float>()
var bool[] rawIsHigh = array.new<bool>()
var string[] rawSource = array.new<string>()
var bool[] rawActive = array.new<bool>()

var float[] candPrice = array.new<float>()
var bool[] candIsHigh = array.new<bool>()
var string[] candSource = array.new<string>()
var bool[] candActive = array.new<bool>()
var bool[] candPendingSweep = array.new<bool>()
var int[] candPendingBar = array.new<int>()
var line[] candLine = array.new<line>()

var label[] labels = array.new<label>()
var string lastStatus = "None"
var string lastSource = ""
var float lastPrice = na
bool sfpEventThisBar = false

sourceShort(src) =>
    str.contains(src, "current") ? "15m/current" : str.contains(src, "1H") ? "1H" : str.contains(src, "4H") ? "4H" : src

levelColor(isHigh, active) =>
    base = isHigh ? color.rgb(255, 80, 130) : color.lime
    active ? color.new(base, 0) : color.new(base, 84)

rememberLabel(lb) =>
    if not na(lb)
        array.push(labels, lb)
        if array.size(labels) > maxLabels
            label.delete(array.shift(labels))

labelAt(price, labelText, isHigh, bg) =>
    rememberLabel(label.new(bar_index, price, labelText, style=isHigh ? label.style_label_down : label.style_label_up, color=bg, textcolor=color.white, size=size.tiny))

rawMove(price, isHigh) =>
    isHigh ? price - low : high - price

hasDuplicateCandidate(price, isHigh) =>
    bool duplicate = false
    if array.size(candPrice) > 0
        for i = 0 to array.size(candPrice) - 1
            duplicate := duplicate or (array.get(candActive, i) and array.get(candIsHigh, i) == isHigh and math.abs(array.get(candPrice, i) - price) <= mergeUsd)
    duplicate

addRawSwing(price, isHigh, src) =>
    if not na(price)
        array.push(rawPrice, price)
        array.push(rawIsHigh, isHigh)
        array.push(rawSource, src)
        array.push(rawActive, true)
        if array.size(rawPrice) > maxRawSwings
            array.shift(rawPrice)
            array.shift(rawIsHigh)
            array.shift(rawSource)
            array.shift(rawActive)

addCandidate(price, isHigh, src) =>
    bool added = false
    if not hasDuplicateCandidate(price, isHigh)
        ln = line.new(bar_index, price, bar_index + 1, price, color=levelColor(isHigh, true), width=2, extend=extend.right)
        array.push(candPrice, price)
        array.push(candIsHigh, isHigh)
        array.push(candSource, src)
        array.push(candActive, true)
        array.push(candPendingSweep, false)
        array.push(candPendingBar, na)
        array.push(candLine, ln)
        added := true
        if array.size(candPrice) > maxCandidates
            oldLine = array.shift(candLine)
            line.delete(oldLine)
            array.shift(candPrice)
            array.shift(candIsHigh)
            array.shift(candSource)
            array.shift(candActive)
            array.shift(candPendingSweep)
            array.shift(candPendingBar)
    added

retireCandidate(i) =>
    array.set(candActive, i, false)
    array.set(candPendingSweep, i, false)
    ln = array.get(candLine, i)
    line.set_extend(ln, extend.none)
    line.set_x2(ln, bar_index)
    line.set_color(ln, levelColor(array.get(candIsHigh, i), false))
    line.set_width(ln, 1)
    if not showPastLevels
        line.delete(ln)

// 1) Collect raw swings. They are internal only, not trading levels.
currentHigh = useCurrentTfSwings ? ta.pivothigh(high, currentTfPivotLen, currentTfPivotLen) : na
currentLow = useCurrentTfSwings ? ta.pivotlow(low, currentTfPivotLen, currentTfPivotLen) : na
if not na(currentHigh)
    addRawSwing(currentHigh, true, "current TF swing high")
if not na(currentLow)
    addRawSwing(currentLow, false, "current TF swing low")

htfPH(tf) => request.security(syminfo.tickerid, tf, ta.pivothigh(high, htfPivotLen, htfPivotLen), barmerge.gaps_off, barmerge.lookahead_off)
htfPL(tf) => request.security(syminfo.tickerid, tf, ta.pivotlow(low, htfPivotLen, htfPivotLen), barmerge.gaps_off, barmerge.lookahead_off)
newVal(x) => not na(x) and na(x[1])

p1hH = use1HSwings ? htfPH("60") : na
p1hL = use1HSwings ? htfPL("60") : na
p4hH = use4HSwings ? htfPH("240") : na
p4hL = use4HSwings ? htfPL("240") : na
if newVal(p1hH)
    addRawSwing(p1hH, true, "1H swing high")
if newVal(p1hL)
    addRawSwing(p1hL, false, "1H swing low")
if newVal(p4hH)
    addRawSwing(p4hH, true, "4H swing high")
if newVal(p4hL)
    addRawSwing(p4hL, false, "4H swing low")

// 2) Raw swing becomes Candidate only after price moved 700+ USD away.
if array.size(rawPrice) > 0
    for i = 0 to array.size(rawPrice) - 1
        if array.get(rawActive, i)
            rp = array.get(rawPrice, i)
            rh = array.get(rawIsHigh, i)
            rs = array.get(rawSource, i)
            moveSize = rawMove(rp, rh)
            if moveSize >= minMoveUsd
                wasAdded = addCandidate(rp, rh, rs)
                array.set(rawActive, i, false)
                if wasAdded
                    lastStatus := rh ? "Candidate High" : "Candidate Low"
                    lastSource := sourceShort(rs)
                    lastPrice := rp
                    if showCandidateLabels
                        candidateText = (rh ? "Candidate High" : "Candidate Low") + " · " + sourceShort(rs) + " · +" + str.tostring(math.round(moveSize))
                        labelAt(rp, candidateText, rh, color.new(levelColor(rh, true), 0))

// 3) D/W/M body reference levels. Reference only, not Candidates.
dHigh = useDwmBodyReference ? request.security(syminfo.tickerid, "D", math.max(open[1], close[1]), barmerge.gaps_off, barmerge.lookahead_off) : na
dLow = useDwmBodyReference ? request.security(syminfo.tickerid, "D", math.min(open[1], close[1]), barmerge.gaps_off, barmerge.lookahead_off) : na
wHigh = useDwmBodyReference ? request.security(syminfo.tickerid, "W", math.max(open[1], close[1]), barmerge.gaps_off, barmerge.lookahead_off) : na
wLow = useDwmBodyReference ? request.security(syminfo.tickerid, "W", math.min(open[1], close[1]), barmerge.gaps_off, barmerge.lookahead_off) : na
mHigh = useDwmBodyReference ? request.security(syminfo.tickerid, "M", math.max(open[1], close[1]), barmerge.gaps_off, barmerge.lookahead_off) : na
mLow = useDwmBodyReference ? request.security(syminfo.tickerid, "M", math.min(open[1], close[1]), barmerge.gaps_off, barmerge.lookahead_off) : na
plot(dHigh, "D Body High reference", color=color.new(color.lime, 72), linewidth=1, style=plot.style_linebr)
plot(dLow, "D Body Low reference", color=color.new(color.lime, 72), linewidth=1, style=plot.style_linebr)
plot(wHigh, "W Body High reference", color=color.new(color.orange, 72), linewidth=1, style=plot.style_linebr)
plot(wLow, "W Body Low reference", color=color.new(color.orange, 72), linewidth=1, style=plot.style_linebr)
plot(mHigh, "M Body High reference", color=color.new(color.white, 72), linewidth=1, style=plot.style_linebr)
plot(mLow, "M Body Low reference", color=color.new(color.white, 72), linewidth=1, style=plot.style_linebr)

// 4) Watch Candidates for sweep -> SFP confirmed / broken.
if array.size(candPrice) > 0
    for i = 0 to array.size(candPrice) - 1
        if array.get(candActive, i)
            cp = array.get(candPrice, i)
            ch = array.get(candIsHigh, i)
            cs = array.get(candSource, i)
            ln = array.get(candLine, i)
            line.set_x2(ln, bar_index + 1)
            sameBarSfp = ch ? high > cp and close < cp : low < cp and close > cp
            sweptNoReclaim = ch ? high > cp and close >= cp : low < cp and close <= cp
            cleanBreak = ch ? close > cp + cleanBreakUsdBuffer : close < cp - cleanBreakUsdBuffer
            pending = array.get(candPendingSweep, i)
            pendingBar = array.get(candPendingBar, i)
            nextBarSfp = pending and bar_index - pendingBar <= maxImmediateReclaimBars and (ch ? close < cp : close > cp)
            if sweptNoReclaim and not sameBarSfp
                array.set(candPendingSweep, i, true)
                array.set(candPendingBar, i, bar_index)
                lastStatus := ch ? "Swept Candidate High" : "Swept Candidate Low"
                lastSource := sourceShort(cs)
                lastPrice := cp
                if showSweepLabels
                    labelAt(cp, ch ? "Swept Candidate High" : "Swept Candidate Low", ch, color.new(color.gray, 25))
            if sameBarSfp or nextBarSfp
                lastStatus := ch ? "SFP High confirmed" : "SFP Low confirmed"
                lastSource := sourceShort(cs)
                lastPrice := cp
                sfpEventThisBar := true
                if showSfpLabels
                    sfpText = (ch ? "SFP High confirmed" : "SFP Low confirmed") + " · " + sourceShort(cs)
                    labelAt(cp, sfpText, ch, color.new(levelColor(ch, true), 0))
                retireCandidate(i)
            else if cleanBreak and not sameBarSfp and not nextBarSfp
                lastStatus := ch ? "Candidate High broken" : "Candidate Low broken"
                lastSource := sourceShort(cs)
                lastPrice := cp
                if showBrokenLabels
                    labelAt(cp, ch ? "Candidate High broken" : "Candidate Low broken", ch, color.new(color.red, 35))
                retireCandidate(i)
            else if pending and bar_index - pendingBar > maxImmediateReclaimBars
                array.set(candPendingSweep, i, false)

nearest = "None"
float nearestDist = na
if array.size(candPrice) > 0
    for i = 0 to array.size(candPrice) - 1
        if array.get(candActive, i)
            cp = array.get(candPrice, i)
            ch = array.get(candIsHigh, i)
            validSide = ch ? cp > close : cp < close
            dist = math.abs(close - cp)
            if validSide and (na(nearestDist) or dist < nearestDist)
                nearestDist := dist
                nearest := (ch ? "Candidate High " : "Candidate Low ") + str.tostring(cp, format.mintick) + " · " + sourceShort(array.get(candSource, i))

var table dash = table.new(position.top_right, 2, 5, border_width=1)
if showDashboard and barstate.islast
    table.clear(dash, 0, 0, 1, 4)
    table.cell(dash, 0, 0, "Version", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 1, 0, "Candidate Debug v0.2", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 0, 1, "Nearest Candidate", text_color=color.white)
    table.cell(dash, 1, 1, nearest, text_color=color.white)
    table.cell(dash, 0, 2, "Last status", text_color=color.white)
    table.cell(dash, 1, 2, lastStatus, text_color=color.white)
    table.cell(dash, 0, 3, "Source", text_color=color.white)
    table.cell(dash, 1, 3, lastSource, text_color=color.white)
    table.cell(dash, 0, 4, "Price", text_color=color.white)
    table.cell(dash, 1, 4, na(lastPrice) ? "" : str.tostring(lastPrice, format.mintick), text_color=color.white)

alertcondition(sfpEventThisBar, title="SFP confirmed from Candidate", message="SFP confirmed from Candidate SFP Level on {{ticker}} {{interval}}.")
