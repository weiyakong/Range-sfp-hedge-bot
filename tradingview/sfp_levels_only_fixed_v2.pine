//@version=6
indicator("SFP Levels Only Fixed v0.2", overlay=true, max_lines_count=500, max_labels_count=120)

showDashboard = input.bool(true, "Show dashboard")
showSfpLabels = input.bool(true, "Show SFP labels")
showSourceInLabels = input.bool(true, "Show source in labels")
showPastLevels = input.bool(false, "Show past/broken levels")
use1H = input.bool(true, "Use 1H")
use4H = input.bool(true, "Use 4H")
use8H = input.bool(true, "Use 8H")
use12H = input.bool(true, "Use 12H")
use1D = input.bool(true, "Use 1D")
useDwmBody = input.bool(true, "Use D/W/M body")
useLtf = input.bool(false, "Use current-TF swings")
htfPivotLen = input.int(3, "HTF pivot length", minval=2, maxval=20)
ltfPivotLen = input.int(5, "Current-TF pivot length", minval=2, maxval=30)
mergeUsd = input.float(100.0, "Merge nearby levels USD", minval=0.0, step=10.0)
cleanBreakUsdBuffer = input.float(100.0, "Clean break USD buffer", minval=0.0, step=10.0)
cleanBreakAtrBuffer = input.float(0.3, "Clean break ATR buffer", minval=0.0, step=0.05)
maxImmediateReclaimBars = input.int(1, "Immediate reclaim window bars", minval=0, maxval=2)
eventCooldownBars = input.int(6, "Event cooldown bars", minval=1, maxval=100)
atrLen = input.int(14, "ATR length", minval=1)
maxLevels = input.int(80, "Max stored levels", minval=20, maxval=250)
maxVisibleLabels = input.int(40, "Max visible labels", minval=5, maxval=120)

atrValue = ta.atr(atrLen)
breakBuffer = math.max(cleanBreakUsdBuffer, not na(atrValue) ? atrValue * cleanBreakAtrBuffer : 0.0)

var float[] prices = array.new<float>()
var bool[] isHighArr = array.new<bool>()
var bool[] activeArr = array.new<bool>()
var string[] srcArr = array.new<string>()
var int[] bornArr = array.new<int>()
var int[] lastEvtArr = array.new<int>()
var int[] pendingBarArr = array.new<int>()
var bool[] pendingArr = array.new<bool>()
var line[] lineArr = array.new<line>()
var label[] labelArr = array.new<label>()

var string lastEvent = "None"
var string lastSource = ""
var float lastPrice = na
bool sfpEventThisBar = false

shortSource(src) =>
    str.contains(src, "1H") ? "1H" : str.contains(src, "4H") ? "4H" : str.contains(src, "8H") ? "8H" : str.contains(src, "12H") ? "12H" : str.contains(src, "1D") ? "1D" : str.contains(src, "Daily") ? "D Body" : str.contains(src, "Weekly") ? "W Body" : str.contains(src, "Monthly") ? "M Body" : str.contains(src, "LTF") ? "LTF" : src

levelColor(isHigh, active) =>
    base = isHigh ? color.rgb(255, 80, 130) : color.lime
    active ? color.new(base, 0) : color.new(base, 85)

rememberLabel(lb) =>
    if not na(lb)
        array.push(labelArr, lb)
        if array.size(labelArr) > maxVisibleLabels
            label.delete(array.shift(labelArr))

addLevel(price, isHigh, src) =>
    if not na(price)
        bool duplicate = false
        if array.size(prices) > 0
            for i = 0 to array.size(prices) - 1
                duplicate := duplicate or (array.get(activeArr, i) and array.get(isHighArr, i) == isHigh and math.abs(array.get(prices, i) - price) <= mergeUsd)
        if not duplicate
            ln = line.new(bar_index, price, bar_index + 1, price, color=levelColor(isHigh, true), width=2)
            array.push(prices, price)
            array.push(isHighArr, isHigh)
            array.push(activeArr, true)
            array.push(srcArr, src)
            array.push(bornArr, bar_index)
            array.push(lastEvtArr, na)
            array.push(pendingBarArr, na)
            array.push(pendingArr, false)
            array.push(lineArr, ln)
            if array.size(prices) > maxLevels
                oldLine = array.shift(lineArr)
                line.delete(oldLine)
                array.shift(prices)
                array.shift(isHighArr)
                array.shift(activeArr)
                array.shift(srcArr)
                array.shift(bornArr)
                array.shift(lastEvtArr)
                array.shift(pendingBarArr)
                array.shift(pendingArr)

makePast(i) =>
    array.set(activeArr, i, false)
    array.set(pendingArr, i, false)
    ln = array.get(lineArr, i)
    line.set_x2(ln, bar_index)
    line.set_color(ln, levelColor(array.get(isHighArr, i), false))
    line.set_width(ln, 1)
    if not showPastLevels
        line.delete(ln)

plotSfpLabel(isHigh, src) =>
    txt = isHigh ? "SFP High" : "SFP Low"
    txt := showSourceInLabels ? txt + " · " + shortSource(src) : txt
    rememberLabel(label.new(bar_index, isHigh ? high : low, txt, style=isHigh ? label.style_label_down : label.style_label_up, color=levelColor(isHigh, true), textcolor=color.white, size=size.tiny))

htfPH(tf) => request.security(syminfo.tickerid, tf, ta.pivothigh(high, htfPivotLen, htfPivotLen), barmerge.gaps_off, barmerge.lookahead_off)
htfPL(tf) => request.security(syminfo.tickerid, tf, ta.pivotlow(low, htfPivotLen, htfPivotLen), barmerge.gaps_off, barmerge.lookahead_off)

var float last1hH = na
var float last1hL = na
var float last4hH = na
var float last4hL = na
var float last8hH = na
var float last8hL = na
var float last12hH = na
var float last12hL = na
var float last1dH = na
var float last1dL = na

p1hH = use1H ? htfPH("60") : na
p1hL = use1H ? htfPL("60") : na
p4hH = use4H ? htfPH("240") : na
p4hL = use4H ? htfPL("240") : na
p8hH = use8H ? htfPH("480") : na
p8hL = use8H ? htfPL("480") : na
p12hH = use12H ? htfPH("720") : na
p12hL = use12H ? htfPL("720") : na
p1dH = use1D ? htfPH("D") : na
p1dL = use1D ? htfPL("D") : na

if not na(p1hH) and p1hH != last1hH
    last1hH := p1hH
    addLevel(p1hH, true, "1H Swing High")
if not na(p1hL) and p1hL != last1hL
    last1hL := p1hL
    addLevel(p1hL, false, "1H Swing Low")
if not na(p4hH) and p4hH != last4hH
    last4hH := p4hH
    addLevel(p4hH, true, "4H Swing High")
if not na(p4hL) and p4hL != last4hL
    last4hL := p4hL
    addLevel(p4hL, false, "4H Swing Low")
if not na(p8hH) and p8hH != last8hH
    last8hH := p8hH
    addLevel(p8hH, true, "8H Swing High")
if not na(p8hL) and p8hL != last8hL
    last8hL := p8hL
    addLevel(p8hL, false, "8H Swing Low")
if not na(p12hH) and p12hH != last12hH
    last12hH := p12hH
    addLevel(p12hH, true, "12H Swing High")
if not na(p12hL) and p12hL != last12hL
    last12hL := p12hL
    addLevel(p12hL, false, "12H Swing Low")
if not na(p1dH) and p1dH != last1dH
    last1dH := p1dH
    addLevel(p1dH, true, "1D Swing High")
if not na(p1dL) and p1dL != last1dL
    last1dL := p1dL
    addLevel(p1dL, false, "1D Swing Low")

prevDBH = request.security(syminfo.tickerid, "D", math.max(open[1], close[1]), barmerge.gaps_off, barmerge.lookahead_off)
prevDBL = request.security(syminfo.tickerid, "D", math.min(open[1], close[1]), barmerge.gaps_off, barmerge.lookahead_off)
prevWBH = request.security(syminfo.tickerid, "W", math.max(open[1], close[1]), barmerge.gaps_off, barmerge.lookahead_off)
prevWBL = request.security(syminfo.tickerid, "W", math.min(open[1], close[1]), barmerge.gaps_off, barmerge.lookahead_off)
prevMBH = request.security(syminfo.tickerid, "M", math.max(open[1], close[1]), barmerge.gaps_off, barmerge.lookahead_off)
prevMBL = request.security(syminfo.tickerid, "M", math.min(open[1], close[1]), barmerge.gaps_off, barmerge.lookahead_off)

var float lastDBH = na
var float lastDBL = na
var float lastWBH = na
var float lastWBL = na
var float lastMBH = na
var float lastMBL = na

if useDwmBody and not na(prevDBH) and prevDBH != lastDBH
    lastDBH := prevDBH
    addLevel(prevDBH, true, "Daily Body High")
if useDwmBody and not na(prevDBL) and prevDBL != lastDBL
    lastDBL := prevDBL
    addLevel(prevDBL, false, "Daily Body Low")
if useDwmBody and not na(prevWBH) and prevWBH != lastWBH
    lastWBH := prevWBH
    addLevel(prevWBH, true, "Weekly Body High")
if useDwmBody and not na(prevWBL) and prevWBL != lastWBL
    lastWBL := prevWBL
    addLevel(prevWBL, false, "Weekly Body Low")
if useDwmBody and not na(prevMBH) and prevMBH != lastMBH
    lastMBH := prevMBH
    addLevel(prevMBH, true, "Monthly Body High")
if useDwmBody and not na(prevMBL) and prevMBL != lastMBL
    lastMBL := prevMBL
    addLevel(prevMBL, false, "Monthly Body Low")

ltfH = useLtf ? ta.pivothigh(high, ltfPivotLen, ltfPivotLen) : na
ltfL = useLtf ? ta.pivotlow(low, ltfPivotLen, ltfPivotLen) : na
if useLtf and not na(ltfH)
    addLevel(ltfH, true, "LTF Swing High")
if useLtf and not na(ltfL)
    addLevel(ltfL, false, "LTF Swing Low")

if array.size(prices) > 0
    for i = 0 to array.size(prices) - 1
        if array.get(activeArr, i)
            price = array.get(prices, i)
            isHigh = array.get(isHighArr, i)
            src = array.get(srcArr, i)
            line.set_x2(array.get(lineArr, i), bar_index + 1)
            bornBefore = array.get(bornArr, i) < bar_index
            lastEvt = array.get(lastEvtArr, i)
            cooldownOk = na(lastEvt) or bar_index - lastEvt >= eventCooldownBars
            pending = array.get(pendingArr, i)
            pendingBar = array.get(pendingBarArr, i)
            if bornBefore
                sameBarSfp = isHigh ? high > price and close < price : low < price and close > price
                nextBarSfp = pending and bar_index - pendingBar <= maxImmediateReclaimBars and (isHigh ? close < price : close > price)
                cleanBreak = isHigh ? close > price + breakBuffer : close < price - breakBuffer
                if isHigh and high > price and close >= price and not sameBarSfp
                    array.set(pendingArr, i, true)
                    array.set(pendingBarArr, i, bar_index)
                if not isHigh and low < price and close <= price and not sameBarSfp
                    array.set(pendingArr, i, true)
                    array.set(pendingBarArr, i, bar_index)
                if cooldownOk and (sameBarSfp or nextBarSfp)
                    lastEvent := isHigh ? "SFP High" : "SFP Low"
                    lastSource := shortSource(src)
                    lastPrice := price
                    sfpEventThisBar := true
                    array.set(lastEvtArr, i, bar_index)
                    array.set(pendingArr, i, false)
                    if showSfpLabels
                        plotSfpLabel(isHigh, src)
                else if cleanBreak and not sameBarSfp and not nextBarSfp
                    lastEvent := isHigh ? "Broken High" : "Broken Low"
                    lastSource := shortSource(src)
                    lastPrice := price
                    makePast(i)
                else if pending and bar_index - pendingBar > maxImmediateReclaimBars
                    array.set(pendingArr, i, false)

nearestText = "None"
float nearestDist = na
if array.size(prices) > 0
    for i = 0 to array.size(prices) - 1
        if array.get(activeArr, i)
            price = array.get(prices, i)
            isHigh = array.get(isHighArr, i)
            validSide = isHigh ? price > close : price < close
            dist = math.abs(close - price)
            if validSide and (na(nearestDist) or dist < nearestDist)
                nearestDist := dist
                nearestText := (isHigh ? "High " : "Low ") + str.tostring(price, format.mintick) + " · " + shortSource(array.get(srcArr, i))

var table dash = table.new(position.top_right, 2, 5, border_width=1)
if showDashboard and barstate.islast
    table.clear(dash, 0, 0, 1, 4)
    table.cell(dash, 0, 0, "Version", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 1, 0, "SFP fixed v0.2", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 0, 1, "Nearest active", text_color=color.white)
    table.cell(dash, 1, 1, nearestText, text_color=color.white)
    table.cell(dash, 0, 2, "Last event", text_color=color.white)
    table.cell(dash, 1, 2, lastEvent, text_color=color.white)
    table.cell(dash, 0, 3, "Source", text_color=color.white)
    table.cell(dash, 1, 3, lastSource, text_color=color.white)
    table.cell(dash, 0, 4, "Price", text_color=color.white)
    table.cell(dash, 1, 4, na(lastPrice) ? "" : str.tostring(lastPrice, format.mintick), text_color=color.white)

alertcondition(sfpEventThisBar, title="SFP at active level", message="SFP at active SFP level on {{ticker}} {{interval}}.")
