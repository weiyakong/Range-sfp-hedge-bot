//@version=6
strategy("SFP Smart Money Strategy v1 SHORT ONLY - A/B/C", overlay=true, pyramiding=0, calc_on_every_tick=true, process_orders_on_close=false, max_labels_count=500)

mode = input.string("A", "Management Mode", options=["A", "B", "C"])
swing15 = input.int(20, "15m swing length", minval=3)
swing4h = input.int(20, "4H swing length", minval=3)
eqUsd = input.float(100, "EQH threshold USD", minval=1)
nearUsd = input.float(150, "Confluence proximity USD", minval=1)
minConf = input.int(1, "Min confluence", minval=1, maxval=8)
slBuffer = input.float(20, "SL buffer beyond wick USD", minval=0)
tpStep = input.float(300, "TP step after TP0 USD", minval=1)
slLock = input.float(150, "SL lock after TP USD", minval=0)
feeTaker = input.float(0.10, "Taker one-way fee %", step=0.001)
feeMaker = input.float(0.036, "Maker one-way fee %", step=0.001)
useTakerTaker = input.bool(true, "Chart uses taker+taker")
requireTp0Space = input.bool(true, "No entry if no TP0 space")
minTp0Usd = input.float(100, "Min TP0 distance USD", minval=1)
showTable = input.bool(true, "Show table")

feePct = useTakerTaker ? feeTaker * 2 : feeTaker + feeMaker
feePrice(p) => p * feePct / 100
near(a, b) => not na(a) and not na(b) and math.abs(a - b) <= nearUsd
hitRes(x) => not na(x) and high >= x and close < x

ph15 = request.security(syminfo.tickerid, "15", ta.pivothigh(high, swing15, swing15), lookahead=barmerge.lookahead_off)
pl15 = request.security(syminfo.tickerid, "15", ta.pivotlow(low, swing15, swing15), lookahead=barmerge.lookahead_off)
h15 = ta.valuewhen(not na(ph15), ph15, 0)
h15p = ta.valuewhen(not na(ph15), ph15, 1)
l15 = ta.valuewhen(not na(pl15), pl15, 0)
l15p = ta.valuewhen(not na(pl15), pl15, 1)
eqh = not na(h15) and not na(h15p) and math.abs(h15 - h15p) <= eqUsd ? math.avg(h15, h15p) : na

ph4h = request.security(syminfo.tickerid, "240", ta.pivothigh(high, swing4h, swing4h), lookahead=barmerge.lookahead_off)
pl4h = request.security(syminfo.tickerid, "240", ta.pivotlow(low, swing4h, swing4h), lookahead=barmerge.lookahead_off)
h4 = ta.valuewhen(not na(ph4h), ph4h, 0)
l4 = ta.valuewhen(not na(pl4h), pl4h, 0)

pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
pdl = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_off)
pwh = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_off)
pwl = request.security(syminfo.tickerid, "W", low[1], lookahead=barmerge.lookahead_off)
pmh = request.security(syminfo.tickerid, "M", high[1], lookahead=barmerge.lookahead_off)
pml = request.security(syminfo.tickerid, "M", low[1], lookahead=barmerge.lookahead_off)

bosDn15 = request.security(syminfo.tickerid, "15", ta.crossunder(close, ta.valuewhen(not na(ta.pivotlow(low, swing15, swing15)), ta.pivotlow(low, swing15, swing15), 0)), lookahead=barmerge.lookahead_off)
lastBullHi = request.security(syminfo.tickerid, "15", ta.valuewhen(close > open, high, 0), lookahead=barmerge.lookahead_off)
lastBullLo = request.security(syminfo.tickerid, "15", ta.valuewhen(close > open, low, 0), lookahead=barmerge.lookahead_off)

var float bearObHi = na
var float bearObLo = na
if bosDn15
    bearObHi := lastBullHi
    bearObLo := lastBullLo
if not na(bearObHi) and high > bearObHi
    bearObHi := na
    bearObLo := na

confShort(x) =>
    int c = 0
    c += near(x, h15) ? 1 : 0
    c += near(x, eqh) ? 1 : 0
    c += near(x, pdh) ? 1 : 0
    c += near(x, pwh) ? 1 : 0
    c += near(x, pmh) ? 1 : 0
    c += near(x, bearObHi) ? 1 : 0
    c += near(x, bearObLo) ? 1 : 0
    c += near(x, h4) ? 1 : 0
    c

shortLvl = hitRes(h15) ? h15 : hitRes(eqh) ? eqh : hitRes(pdh) ? pdh : hitRes(pwh) ? pwh : hitRes(pmh) ? pmh : hitRes(bearObHi) ? bearObHi : hitRes(bearObLo) ? bearObLo : na
sc = not na(shortLvl) ? confShort(shortLvl) : 0

float targetDn = na
for x in array.from(l15, l15p, pdl, pwl, pml, l4)
    if not na(x) and x < close
        targetDn := na(targetDn) ? x : math.max(targetDn, x)

var float ep = na
var float sl = na
var float r = na
var float tp0 = na
var float tp1 = na
var float tp2 = na
var float tp3 = na
var float tp4 = na
var float tp5 = na
var bool got0 = false
var bool got1 = false
var bool got2 = false
var bool got3 = false
var bool got4 = false
var bool got5 = false

if strategy.position_size == 0 and not na(ep)
    ep := na
    sl := na
    r := na
    tp0 := na
    tp1 := na
    tp2 := na
    tp3 := na
    tp4 := na
    tp5 := na
    got0 := false
    got1 := false
    got2 := false
    got3 := false
    got4 := false
    got5 := false

shortSl = high + slBuffer
shortR = shortSl - close + feePrice(close)
shortTp0 = close - 2 * shortR
shortSpace = not requireTp0Space or (not na(targetDn) and targetDn <= shortTp0 and close - shortTp0 >= minTp0Usd)
shortOk = strategy.position_size == 0 and not na(shortLvl) and sc >= minConf and shortR > 0 and shortSpace

if shortOk
    ep := close
    sl := shortSl
    r := shortR
    tp0 := ep - 2 * r
    tp1 := tp0 - tpStep
    tp2 := tp0 - 2 * tpStep
    tp3 := tp0 - 3 * tpStep
    tp4 := tp0 - 4 * tpStep
    tp5 := tp0 - 5 * tpStep
    strategy.entry("S", strategy.short)
    label.new(bar_index, high, "S SFP " + str.tostring(sc), style=label.style_label_down, color=color.red, textcolor=color.white)

if strategy.position_size < 0
    got0 := got0 or low <= tp0
    got1 := got1 or low <= tp1
    got2 := got2 or low <= tp2
    got3 := got3 or low <= tp3
    got4 := got4 or low <= tp4
    got5 := got5 or low <= tp5
    if mode == "C" and got0 and not got1
        sl := math.min(sl, ep)
    if got1
        sl := math.min(sl, tp0 - slLock)
    if mode == "B" and got2
        sl := math.min(sl, tp1 - slLock)
    if mode == "B" and got3
        sl := math.min(sl, tp2 - slLock)
    if mode == "B" and got4
        sl := math.min(sl, tp3 - slLock)
    if mode == "B" and got5
        sl := math.min(sl, tp4 - slLock)
    strategy.exit("S0", "S", qty_percent=50, limit=tp0, stop=sl)
    strategy.exit("S1", "S", qty_percent=10, limit=tp1, stop=sl)
    strategy.exit("S2", "S", qty_percent=10, limit=tp2, stop=sl)
    strategy.exit("S3", "S", qty_percent=10, limit=tp3, stop=sl)
    strategy.exit("S4", "S", qty_percent=10, limit=tp4, stop=sl)
    strategy.exit("S5", "S", qty_percent=10, limit=tp5, stop=sl)

plot(pdh, "PDH", color=color.new(color.blue, 40))
plot(pwh, "PWH", color=color.new(color.purple, 40))
plot(eqh, "EQH", color=color.new(color.red, 0))
plot(bearObHi, "Bear OB High", color=color.new(color.red, 60))
plot(bearObLo, "Bear OB Low", color=color.new(color.red, 60))
plot(strategy.position_size != 0 ? sl : na, "SL", color=color.red, linewidth=2, style=plot.style_linebr)
plot(strategy.position_size != 0 ? tp0 : na, "TP0", color=color.green, linewidth=2, style=plot.style_linebr)
plot(strategy.position_size != 0 ? tp1 : na, "TP1", color=color.new(color.green, 20), style=plot.style_linebr)
plot(strategy.position_size != 0 ? tp2 : na, "TP2", color=color.new(color.green, 30), style=plot.style_linebr)
plot(strategy.position_size != 0 ? tp3 : na, "TP3", color=color.new(color.green, 40), style=plot.style_linebr)
plot(strategy.position_size != 0 ? tp4 : na, "TP4", color=color.new(color.green, 50), style=plot.style_linebr)
plot(strategy.position_size != 0 ? tp5 : na, "TP5", color=color.new(color.green, 60), style=plot.style_linebr)

var table tb = table.new(position.top_right, 2, 4, border_width=1)
if showTable and barstate.islast
    table.cell(tb, 0, 0, "SHORT ONLY")
    table.cell(tb, 1, 0, mode)
    table.cell(tb, 0, 1, "Fee")
    table.cell(tb, 1, 1, useTakerTaker ? "taker+taker" : "maker+taker")
    table.cell(tb, 0, 2, "Short conf")
    table.cell(tb, 1, 2, str.tostring(sc))
    table.cell(tb, 0, 3, "R")
    table.cell(tb, 1, 3, na(r) ? "-" : str.tostring(r, "#.##"))
