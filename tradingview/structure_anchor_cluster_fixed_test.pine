//@version=6
indicator("Structure Anchor Cluster Fixed v0.2", overlay=true, max_labels_count=300)

showDashboard = input.bool(true, "Show dashboard")
showRejected = input.bool(false, "Show rejected x labels")
showEntry = input.bool(true, "Show Entry")
showInternal = input.bool(true, "Show Inter")
showWatch = input.bool(true, "Show Watch")
showAnchor = input.bool(true, "Show Anchor")
showRangeBg = input.bool(true, "Show range boundaries")

pivotLen = input.int(5, "Pivot length", minval=2, maxval=40)
minMoveUsd = input.float(1000.0, "Minimum move from raw swing", minval=0, step=50)
structureLookback = input.int(60, "Structure edge lookback", minval=5, maxval=300)
majorRangeLookback = input.int(200, "Major range lookback", minval=50, maxval=600)
entryEdgePercent = input.float(25.0, "Entry edge zone %", minval=5, maxval=45, step=1)
resetUsd = input.float(1500.0, "Reset move USD", minval=0, step=100)
anchorImpulseUsd = input.float(1500.0, "Anchor impulse USD", minval=0, step=100)
mergeUsd = input.float(120.0, "Watch duplicate USD", minval=0, step=10)
clusterUsd = input.float(450.0, "Cluster compression USD", minval=50, step=50)
maxRaw = input.int(160, "Max raw swings", minval=20, maxval=400)
maxLevels = input.int(120, "Max valid levels", minval=20, maxval=300)
maxWatch = input.int(120, "Max watch candidates", minval=20, maxval=300)

var float[] rawP = array.new<float>()
var bool[] rawH = array.new<bool>()
var bool[] rawA = array.new<bool>()
var int[] rawB = array.new<int>()
var bool[] rawE = array.new<bool>()
var float[] rawPos = array.new<float>()

var float[] lvlP = array.new<float>()
var bool[] lvlH = array.new<bool>()
var string[] lvlT = array.new<string>()
var float[] lvlMin = array.new<float>()
var float[] lvlMax = array.new<float>()
var bool[] lvlReady = array.new<bool>()
var bool[] lvlActive = array.new<bool>()
var label[] lvlLbl = array.new<label>()

var float[] watchP = array.new<float>()
var bool[] watchH = array.new<bool>()
var int[] watchB = array.new<int>()
var bool[] watchA = array.new<bool>()

var int entryCount = 0
var int interCount = 0
var int watchCount = 0
var int anchorCount = 0
var int xCount = 0
var int xMiddle = 0
var int xCluster = 0
var int clusterReplace = 0
var string lastStatus = "None"
var float lastLevel = na
var float lastEntryHigh = na
var float lastEntryLow = na
var float lowSinceEntryHigh = na
var float highSinceEntryLow = na
var bool interHighArmed = false
var bool interLowArmed = false
var bool interHighUsed = false
var bool interLowUsed = false

levelColor(isHigh, typ) => typ == "watch" ? color.orange : typ == "internal" ? color.blue : isHigh ? color.red : color.lime
levelText(isHigh, typ) => typ == "watch" ? (isHigh ? "Watch H" : "Watch L") : typ == "internal" ? (isHigh ? "Inter. High" : "Inter. Low") : isHigh ? "Entry High" : "Entry Low"
showTyp(typ) => typ == "watch" ? showWatch : typ == "internal" ? showInternal : showEntry

addRaw(p, isHigh, b, edge, pos) =>
    if not na(p)
        array.push(rawP, p), array.push(rawH, isHigh), array.push(rawA, true), array.push(rawB, b), array.push(rawE, edge), array.push(rawPos, pos)
        if array.size(rawP) > maxRaw
            array.shift(rawP), array.shift(rawH), array.shift(rawA), array.shift(rawB), array.shift(rawE), array.shift(rawPos)

findNear(price, isHigh, dist) =>
    int idx = -1
    float best = na
    if array.size(lvlP) > 0
        for j = 0 to array.size(lvlP) - 1
            if array.get(lvlActive, j) and array.get(lvlH, j) == isHigh
                d = math.abs(array.get(lvlP, j) - price)
                if d <= dist and (na(best) or d < best)
                    best := d
                    idx := j
    idx

canWatch(idx) => idx >= 0 and array.get(lvlT, idx) == "entry" and array.get(lvlReady, idx)

useWatch(idx) =>
    if idx >= 0
        array.set(lvlReady, idx, false)
        array.set(lvlMin, idx, low)
        array.set(lvlMax, idx, high)

addWatch(p, isHigh, b) =>
    array.push(watchP, p), array.push(watchH, isHigh), array.push(watchB, b), array.push(watchA, true)
    if array.size(watchP) > maxWatch
        array.shift(watchP), array.shift(watchH), array.shift(watchB), array.shift(watchA)

addLevelCluster(price, isHigh, typ, originBar) =>
    bool accepted = false
    ci = findNear(price, isHigh, clusterUsd)
    if ci >= 0
        oldPrice = array.get(lvlP, ci)
        better = isHigh ? price > oldPrice : price < oldPrice
        if better
            oldLabel = array.get(lvlLbl, ci)
            label.delete(oldLabel)
            newLabel = showTyp(typ) ? label.new(originBar, price, levelText(isHigh, typ), style=isHigh ? label.style_label_down : label.style_label_up, color=levelColor(isHigh, typ), textcolor=color.white, size=size.tiny) : na
            array.set(lvlP, ci, price)
            array.set(lvlT, ci, typ)
            array.set(lvlMin, ci, low)
            array.set(lvlMax, ci, high)
            array.set(lvlReady, ci, false)
            array.set(lvlLbl, ci, newLabel)
            clusterReplace += 1
            accepted := true
    else
        newLabel = showTyp(typ) ? label.new(originBar, price, levelText(isHigh, typ), style=isHigh ? label.style_label_down : label.style_label_up, color=levelColor(isHigh, typ), textcolor=color.white, size=size.tiny) : na
        array.push(lvlP, price), array.push(lvlH, isHigh), array.push(lvlT, typ), array.push(lvlMin, low), array.push(lvlMax, high), array.push(lvlReady, false), array.push(lvlActive, true), array.push(lvlLbl, newLabel)
        if array.size(lvlP) > maxLevels
            oldLabel = array.shift(lvlLbl)
            label.delete(oldLabel)
            array.shift(lvlP), array.shift(lvlH), array.shift(lvlT), array.shift(lvlMin), array.shift(lvlMax), array.shift(lvlReady), array.shift(lvlActive)
        accepted := true
    accepted

rawMove(p, isHigh) => isHigh ? p - low : high - p
internalOk(isHigh) => isHigh ? interHighArmed : interLowArmed
entryZoneOk(isHigh, pos) => not na(pos) and (isHigh ? pos >= 100 - entryEdgePercent : pos <= entryEdgePercent)

if not na(lastEntryHigh)
    lowSinceEntryHigh := na(lowSinceEntryHigh) ? low : math.min(lowSinceEntryHigh, low)
if not na(lastEntryLow)
    highSinceEntryLow := na(highSinceEntryLow) ? high : math.max(highSinceEntryLow, high)
if not na(lastEntryHigh) and not na(lowSinceEntryHigh) and lastEntryHigh - lowSinceEntryHigh >= resetUsd and not interHighUsed
    interHighArmed := true
if not na(lastEntryLow) and not na(highSinceEntryLow) and highSinceEntryLow - lastEntryLow >= resetUsd and not interLowUsed
    interLowArmed := true

if array.size(lvlP) > 0
    for j = 0 to array.size(lvlP) - 1
        if array.get(lvlActive, j)
            p = array.get(lvlP, j)
            isH = array.get(lvlH, j)
            typ = array.get(lvlT, j)
            mn = math.min(array.get(lvlMin, j), low)
            mx = math.max(array.get(lvlMax, j), high)
            array.set(lvlMin, j, mn)
            array.set(lvlMax, j, mx)
            if typ == "entry"
                if isH and p - mn >= resetUsd
                    array.set(lvlReady, j, true)
                if not isH and mx - p >= resetUsd
                    array.set(lvlReady, j, true)

majorHigh = ta.highest(high, majorRangeLookback)
majorLow = ta.lowest(low, majorRangeLookback)
majorSize = majorHigh - majorLow
upperBoundary = majorLow + majorSize * (100 - entryEdgePercent) / 100
lowerBoundary = majorLow + majorSize * entryEdgePercent / 100
plot(showRangeBg ? upperBoundary : na, "Entry upper boundary", color=color.new(color.red, 65))
plot(showRangeBg ? lowerBoundary : na, "Entry lower boundary", color=color.new(color.lime, 65))

ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)
hiOrigin = ta.highest(high, structureLookback)[pivotLen]
loOrigin = ta.lowest(low, structureLookback)[pivotLen]
majorHighOrigin = ta.highest(high, majorRangeLookback)[pivotLen]
majorLowOrigin = ta.lowest(low, majorRangeLookback)[pivotLen]
majorSizeOrigin = majorHighOrigin - majorLowOrigin

if not na(ph)
    posH = majorSizeOrigin > 0 ? (ph - majorLowOrigin) / majorSizeOrigin * 100 : na
    addRaw(ph, true, bar_index - pivotLen, ph >= hiOrigin, posH)
if not na(pl)
    posL = majorSizeOrigin > 0 ? (pl - majorLowOrigin) / majorSizeOrigin * 100 : na
    addRaw(pl, false, bar_index - pivotLen, pl <= loOrigin, posL)

if array.size(rawP) > 0
    for i = 0 to array.size(rawP) - 1
        if array.get(rawA, i)
            rp = array.get(rawP, i)
            rh = array.get(rawH, i)
            rb = array.get(rawB, i)
            edge = array.get(rawE, i)
            pos = array.get(rawPos, i)
            if rawMove(rp, rh) >= minMoveUsd
                array.set(rawA, i, false)
                dupIdx = findNear(rp, rh, mergeUsd)
                watchOk = canWatch(dupIdx)
                intOk = internalOk(rh)
                if dupIdx >= 0 and watchOk
                    ok = addLevelCluster(rp, rh, "watch", rb)
                    if ok
                        addWatch(rp, rh, rb)
                        useWatch(dupIdx)
                        watchCount += 1
                        lastStatus := rh ? "Watch H" : "Watch L"
                    else
                        xCount += 1
                        xCluster += 1
                        lastStatus := "x cluster"
                else if edge and not entryZoneOk(rh, pos)
                    xCount += 1
                    xMiddle += 1
                    lastStatus := "x middle"
                    if showRejected
                        label.new(rb, rp, "x middle", style=rh ? label.style_label_down : label.style_label_up, color=color.gray, textcolor=color.white, size=size.tiny)
                else if edge
                    ok = addLevelCluster(rp, rh, "entry", rb)
                    if ok
                        entryCount += 1
                        lastStatus := rh ? "Entry High" : "Entry Low"
                        if rh
                            lastEntryHigh := rp
                            lowSinceEntryHigh := low
                            interHighArmed := false
                            interHighUsed := false
                        else
                            lastEntryLow := rp
                            highSinceEntryLow := high
                            interLowArmed := false
                            interLowUsed := false
                    else
                        xCount += 1
                        xCluster += 1
                        lastStatus := "x cluster"
                else if dupIdx >= 0
                    xCount += 1
                    lastStatus := "x duplicate"
                    if showRejected
                        label.new(rb, rp, "x duplicate", style=rh ? label.style_label_down : label.style_label_up, color=color.gray, textcolor=color.white, size=size.tiny)
                else if intOk
                    ok = addLevelCluster(rp, rh, "internal", rb)
                    if ok
                        interCount += 1
                        lastStatus := rh ? "Inter. High" : "Inter. Low"
                        if rh
                            interHighArmed := false
                            interHighUsed := true
                        else
                            interLowArmed := false
                            interLowUsed := true
                    else
                        xCount += 1
                        xCluster += 1
                        lastStatus := "x cluster"
                else
                    xCount += 1
                    lastStatus := "x not edge"
                    if showRejected
                        label.new(rb, rp, "x not edge", style=rh ? label.style_label_down : label.style_label_up, color=color.gray, textcolor=color.white, size=size.tiny)
                lastLevel := rp

if array.size(watchP) > 0
    int hIdx = -1
    int hBar = na
    int lIdx = -1
    int lBar = na
    for i = 0 to array.size(watchP) - 1
        if array.get(watchA, i)
            wp = array.get(watchP, i)
            wh = array.get(watchH, i)
            wb = array.get(watchB, i)
            movedEnough = wh ? wp - low >= anchorImpulseUsd : high - wp >= anchorImpulseUsd
            if movedEnough
                if wh and (hIdx == -1 or wb > hBar)
                    hIdx := i
                    hBar := wb
                if not wh and (lIdx == -1 or wb > lBar)
                    lIdx := i
                    lBar := wb
    if hIdx >= 0
        ap = array.get(watchP, hIdx)
        ab = array.get(watchB, hIdx)
        anchorCount += 1
        lastStatus := "Anchor H"
        lastLevel := ap
        if showAnchor
            label.new(ab, ap, "Anchor H", style=label.style_label_down, color=color.rgb(255, 0, 180), textcolor=color.white, size=size.tiny)
        for k = 0 to array.size(watchP) - 1
            if array.get(watchH, k) and array.get(watchB, k) <= ab
                array.set(watchA, k, false)
    if lIdx >= 0
        ap = array.get(watchP, lIdx)
        ab = array.get(watchB, lIdx)
        anchorCount += 1
        lastStatus := "Anchor L"
        lastLevel := ap
        if showAnchor
            label.new(ab, ap, "Anchor L", style=label.style_label_up, color=color.rgb(255, 0, 180), textcolor=color.white, size=size.tiny)
        for k = 0 to array.size(watchP) - 1
            if not array.get(watchH, k) and array.get(watchB, k) <= ab
                array.set(watchA, k, false)

var table dash = table.new(position.top_right, 2, 10, border_width=1)
if showDashboard and barstate.islast
    table.clear(dash, 0, 0, 1, 9)
    table.cell(dash, 0, 0, "Version", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 1, 0, "Structure Anchor Cluster Fixed v0.2", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 0, 1, "Min / cluster", text_color=color.white)
    table.cell(dash, 1, 1, str.tostring(minMoveUsd) + " / " + str.tostring(clusterUsd), text_color=color.white)
    table.cell(dash, 0, 2, "Entry/Inter/Watch/x", text_color=color.white)
    table.cell(dash, 1, 2, str.tostring(entryCount) + " / " + str.tostring(interCount) + " / " + str.tostring(watchCount) + " / " + str.tostring(xCount), text_color=color.white)
    table.cell(dash, 0, 3, "Anchor", text_color=color.white)
    table.cell(dash, 1, 3, str.tostring(anchorCount), text_color=color.white)
    table.cell(dash, 0, 4, "x middle / cluster", text_color=color.white)
    table.cell(dash, 1, 4, str.tostring(xMiddle) + " / " + str.tostring(xCluster), text_color=color.white)
    table.cell(dash, 0, 5, "Cluster replaced", text_color=color.white)
    table.cell(dash, 1, 5, str.tostring(clusterReplace), text_color=color.white)
    table.cell(dash, 0, 6, "Entry edge zone", text_color=color.white)
    table.cell(dash, 1, 6, str.tostring(entryEdgePercent) + "%", text_color=color.white)
    table.cell(dash, 0, 7, "Anchor impulse", text_color=color.white)
    table.cell(dash, 1, 7, str.tostring(anchorImpulseUsd), text_color=color.white)
    table.cell(dash, 0, 8, "Last", text_color=color.white)
    table.cell(dash, 1, 8, lastStatus + (na(lastLevel) ? "" : " " + str.tostring(lastLevel, format.mintick)), text_color=color.white)
    table.cell(dash, 0, 9, "Cluster rule", text_color=color.white)
    table.cell(dash, 1, 9, "high=max / low=min", text_color=color.white)
