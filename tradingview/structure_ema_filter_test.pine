//@version=6
indicator("Structure EMA Filter Test v0.1", overlay=true, max_labels_count=300)

showDashboard = input.bool(true, "Show dashboard")
showRejected = input.bool(true, "Show rejected")
showEntry = input.bool(true, "Show entry levels")
showInternal = input.bool(true, "Show internal")
showWatch = input.bool(true, "Show watch levels")
showEmaBg = input.bool(true, "Show EMA regime background")

pivotLen = input.int(5, "Pivot length", minval=2, maxval=40)
minMoveUsd = input.float(700.0, "Minimum move from raw swing", minval=0.0, step=50.0)
structureLookback = input.int(60, "Structure edge lookback", minval=5, maxval=300)
resetUsd = input.float(1500.0, "Reset move USD", minval=0.0, step=100.0)
mergeUsd = input.float(120.0, "Nearby level USD", minval=0.0, step=10.0)
maxRaw = input.int(160, "Max raw swings", minval=20, maxval=400)
maxLevels = input.int(120, "Max levels", minval=20, maxval=300)

emaFastLen = input.int(7, "Fast EMA", minval=1)
emaMidLen = input.int(14, "Middle EMA", minval=1)
emaSlowLen = input.int(28, "Slow EMA", minval=1)
atrLen = input.int(14, "ATR length", minval=1)
compressionAtr = input.float(0.20, "EMA compression: spread / ATR", minval=0.01, step=0.01)
expansionAtr = input.float(0.45, "EMA expansion: spread / ATR", minval=0.01, step=0.01)
crossLookback = input.int(12, "EMA cross lookback", minval=3, maxval=80)
minCrosses = input.int(4, "Min crosses for chop", minval=1, maxval=40)
blockEntryOnCompression = input.bool(true, "Block Entry on compression/chop")
blockInternalOnCompression = input.bool(true, "Block Inter. on compression/chop")
blockCounterImpulseEntry = input.bool(true, "Block counter-impulse Entry")
blockCounterImpulseInternal = input.bool(true, "Block counter-impulse Inter.")

emaFast = ta.ema(close, emaFastLen)
emaMid = ta.ema(close, emaMidLen)
emaSlow = ta.ema(close, emaSlowLen)
atr = ta.atr(atrLen)
emaMax = math.max(emaFast, math.max(emaMid, emaSlow))
emaMin = math.min(emaFast, math.min(emaMid, emaSlow))
emaSpreadAtr = atr > 0 ? (emaMax - emaMin) / atr : na
emaCompressed = not na(emaSpreadAtr) and emaSpreadAtr <= compressionAtr
emaExpanded = not na(emaSpreadAtr) and emaSpreadAtr >= expansionAtr
crossFast = ta.cross(close, emaFast) ? 1 : 0
crossCount = math.sum(crossFast, crossLookback)
emaChop = emaCompressed and crossCount >= minCrosses
bullExpansion = emaExpanded and emaFast > emaMid and emaMid > emaSlow
bearExpansion = emaExpanded and emaFast < emaMid and emaMid < emaSlow

bgcolor(showEmaBg and emaChop ? color.new(color.yellow, 88) : na)

var float[] rawPrice = array.new<float>()
var bool[] rawHigh = array.new<bool>()
var bool[] rawActive = array.new<bool>()
var int[] rawBar = array.new<int>()
var bool[] rawEdge = array.new<bool>()

var float[] lvlPrice = array.new<float>()
var bool[] lvlHigh = array.new<bool>()
var string[] lvlType = array.new<string>()
var float[] lvlMin = array.new<float>()
var float[] lvlMax = array.new<float>()
var bool[] lvlReady = array.new<bool>()

var int entryCount = 0
var int internalCount = 0
var int watchCount = 0
var int xCount = 0
var int xCompressionCount = 0
var int xImpulseCount = 0
var string lastStatus = "None"
var float lastLevel = na
var float lastEntryHigh = na
var float lastEntryLow = na
var float lowSinceEntryHigh = na
var float highSinceEntryLow = na

if not na(lastEntryHigh)
    lowSinceEntryHigh := na(lowSinceEntryHigh) ? low : math.min(lowSinceEntryHigh, low)
if not na(lastEntryLow)
    highSinceEntryLow := na(highSinceEntryLow) ? high : math.max(highSinceEntryLow, high)

if array.size(lvlPrice) > 0
    for j = 0 to array.size(lvlPrice) - 1
        p = array.get(lvlPrice, j)
        h = array.get(lvlHigh, j)
        t = array.get(lvlType, j)
        mn = math.min(array.get(lvlMin, j), low)
        mx = math.max(array.get(lvlMax, j), high)
        array.set(lvlMin, j, mn)
        array.set(lvlMax, j, mx)
        if t == "entry"
            if h and p - mn >= resetUsd
                array.set(lvlReady, j, true)
            if not h and mx - p >= resetUsd
                array.set(lvlReady, j, true)

nearestSame(price, isHigh) =>
    int idx = -1
    float best = na
    if array.size(lvlPrice) > 0
        for j = 0 to array.size(lvlPrice) - 1
            if array.get(lvlHigh, j) == isHigh
                d = math.abs(array.get(lvlPrice, j) - price)
                if d <= mergeUsd and (na(best) or d < best)
                    best := d
                    idx := j
    idx

canWatch(idx) =>
    idx >= 0 and array.get(lvlType, idx) == "entry" and array.get(lvlReady, idx)

useWatch(idx) =>
    if idx >= 0
        array.set(lvlReady, idx, false)
        array.set(lvlMin, idx, low)
        array.set(lvlMax, idx, high)

addLevel(price, isHigh, typ) =>
    array.push(lvlPrice, price)
    array.push(lvlHigh, isHigh)
    array.push(lvlType, typ)
    array.push(lvlMin, low)
    array.push(lvlMax, high)
    array.push(lvlReady, false)
    if array.size(lvlPrice) > maxLevels
        array.shift(lvlPrice)
        array.shift(lvlHigh)
        array.shift(lvlType)
        array.shift(lvlMin)
        array.shift(lvlMax)
        array.shift(lvlReady)

addRaw(price, isHigh, originBar, isEdge) =>
    if not na(price)
        array.push(rawPrice, price)
        array.push(rawHigh, isHigh)
        array.push(rawActive, true)
        array.push(rawBar, originBar)
        array.push(rawEdge, isEdge)
        if array.size(rawPrice) > maxRaw
            array.shift(rawPrice)
            array.shift(rawHigh)
            array.shift(rawActive)
            array.shift(rawBar)
            array.shift(rawEdge)

rawMove(price, isHigh) => isHigh ? price - low : high - price

internalOk(isHigh) =>
    isHigh ? (not na(lastEntryHigh) and not na(lowSinceEntryHigh) and lastEntryHigh - lowSinceEntryHigh >= resetUsd) : (not na(lastEntryLow) and not na(highSinceEntryLow) and highSinceEntryLow - lastEntryLow >= resetUsd)

entryBlockedByImpulse(isHigh) =>
    blockCounterImpulseEntry and ((isHigh and bullExpansion) or (not isHigh and bearExpansion))

internalBlockedByImpulse(isHigh) =>
    blockCounterImpulseInternal and ((isHigh and bullExpansion) or (not isHigh and bearExpansion))

ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)
hiOrigin = ta.highest(high, structureLookback)[pivotLen]
loOrigin = ta.lowest(low, structureLookback)[pivotLen]

if not na(ph)
    addRaw(ph, true, bar_index - pivotLen, ph >= hiOrigin)
if not na(pl)
    addRaw(pl, false, bar_index - pivotLen, pl <= loOrigin)

if array.size(rawPrice) > 0
    for i = 0 to array.size(rawPrice) - 1
        if array.get(rawActive, i)
            rp = array.get(rawPrice, i)
            rh = array.get(rawHigh, i)
            rb = array.get(rawBar, i)
            edge = array.get(rawEdge, i)
            if rawMove(rp, rh) >= minMoveUsd
                array.set(rawActive, i, false)
                dupIdx = nearestSame(rp, rh)
                dup = dupIdx >= 0
                watchOk = canWatch(dupIdx)
                intOk = internalOk(rh)
                if dup and watchOk
                    addLevel(rp, rh, "watch")
                    useWatch(dupIdx)
                    watchCount += 1
                    lastStatus := rh ? "Watch H" : "Watch L"
                    lastLevel := rp
                    if showWatch
                        label.new(rb, rp, rh ? "Watch H" : "Watch L", style=rh ? label.style_label_down : label.style_label_up, color=color.new(color.orange, 0), textcolor=color.white, size=size.tiny)
                else if edge
                    if emaChop and blockEntryOnCompression
                        xCount += 1
                        xCompressionCount += 1
                        lastStatus := "x compression"
                        lastLevel := rp
                        if showRejected
                            label.new(rb, rp, "x compression", style=rh ? label.style_label_down : label.style_label_up, color=color.new(color.yellow, 0), textcolor=color.black, size=size.tiny)
                    else if entryBlockedByImpulse(rh)
                        xCount += 1
                        xImpulseCount += 1
                        lastStatus := "x impulse"
                        lastLevel := rp
                        if showRejected
                            label.new(rb, rp, "x impulse", style=rh ? label.style_label_down : label.style_label_up, color=color.new(color.gray, 0), textcolor=color.white, size=size.tiny)
                    else
                        addLevel(rp, rh, "entry")
                        entryCount += 1
                        lastStatus := rh ? "Entry High" : "Entry Low"
                        lastLevel := rp
                        if rh
                            lastEntryHigh := rp
                            lowSinceEntryHigh := low
                        else
                            lastEntryLow := rp
                            highSinceEntryLow := high
                        if showEntry
                            label.new(rb, rp, rh ? "Entry High" : "Entry Low", style=rh ? label.style_label_down : label.style_label_up, color=rh ? color.new(color.red, 0) : color.new(color.lime, 0), textcolor=color.white, size=size.tiny)
                else if dup
                    xCount += 1
                    lastStatus := "x duplicate"
                    lastLevel := rp
                    if showRejected
                        label.new(rb, rp, "x duplicate", style=rh ? label.style_label_down : label.style_label_up, color=color.new(color.gray, 0), textcolor=color.white, size=size.tiny)
                else if intOk
                    if emaChop and blockInternalOnCompression
                        xCount += 1
                        xCompressionCount += 1
                        lastStatus := "x compression"
                        lastLevel := rp
                        if showRejected
                            label.new(rb, rp, "x compression", style=rh ? label.style_label_down : label.style_label_up, color=color.new(color.yellow, 0), textcolor=color.black, size=size.tiny)
                    else if internalBlockedByImpulse(rh)
                        xCount += 1
                        xImpulseCount += 1
                        lastStatus := "x impulse"
                        lastLevel := rp
                        if showRejected
                            label.new(rb, rp, "x impulse", style=rh ? label.style_label_down : label.style_label_up, color=color.new(color.gray, 0), textcolor=color.white, size=size.tiny)
                    else
                        addLevel(rp, rh, "internal")
                        internalCount += 1
                        lastStatus := rh ? "Inter. High" : "Inter. Low"
                        lastLevel := rp
                        if showInternal
                            label.new(rb, rp, rh ? "Inter. High" : "Inter. Low", style=rh ? label.style_label_down : label.style_label_up, color=color.new(color.blue, 0), textcolor=color.white, size=size.tiny)
                else
                    xCount += 1
                    lastStatus := "x not edge"
                    lastLevel := rp
                    if showRejected
                        label.new(rb, rp, "x not edge", style=rh ? label.style_label_down : label.style_label_up, color=color.new(color.gray, 0), textcolor=color.white, size=size.tiny)

var table dash = table.new(position.top_right, 2, 9, border_width=1)
if showDashboard and barstate.islast
    table.clear(dash, 0, 0, 1, 8)
    table.cell(dash, 0, 0, "Version", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 1, 0, "Structure EMA v0.1", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 0, 1, "EMA regime", text_color=color.white)
    table.cell(dash, 1, 1, emaChop ? "compression" : bullExpansion ? "bull impulse" : bearExpansion ? "bear impulse" : "normal", text_color=color.white)
    table.cell(dash, 0, 2, "EMA spread / ATR", text_color=color.white)
    table.cell(dash, 1, 2, na(emaSpreadAtr) ? "" : str.tostring(emaSpreadAtr, "#.###"), text_color=color.white)
    table.cell(dash, 0, 3, "Crosses", text_color=color.white)
    table.cell(dash, 1, 3, str.tostring(crossCount) + " / " + str.tostring(crossLookback), text_color=color.white)
    table.cell(dash, 0, 4, "Entry/Inter./Watch/x", text_color=color.white)
    table.cell(dash, 1, 4, str.tostring(entryCount) + " / " + str.tostring(internalCount) + " / " + str.tostring(watchCount) + " / " + str.tostring(xCount), text_color=color.white)
    table.cell(dash, 0, 5, "x comp / x impulse", text_color=color.white)
    table.cell(dash, 1, 5, str.tostring(xCompressionCount) + " / " + str.tostring(xImpulseCount), text_color=color.white)
    table.cell(dash, 0, 6, "Last", text_color=color.white)
    table.cell(dash, 1, 6, lastStatus + (na(lastLevel) ? "" : " " + str.tostring(lastLevel, format.mintick)), text_color=color.white)
    table.cell(dash, 0, 7, "Since Entry High", text_color=color.white)
    table.cell(dash, 1, 7, na(lastEntryHigh) or na(lowSinceEntryHigh) ? "" : str.tostring(lastEntryHigh - lowSinceEntryHigh, "#.##"), text_color=color.white)
    table.cell(dash, 0, 8, "Since Entry Low", text_color=color.white)
    table.cell(dash, 1, 8, na(lastEntryLow) or na(highSinceEntryLow) ? "" : str.tostring(highSinceEntryLow - lastEntryLow, "#.##"), text_color=color.white)
