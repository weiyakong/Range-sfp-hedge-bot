//@version=6
indicator("Structure + Internal Levels Test v0.2", overlay=true, max_labels_count=300)

showDashboard = input.bool(true, "Show dashboard")
showRejected = input.bool(true, "Show rejected raw swings")
showCandidates = input.bool(true, "Show candidates")
showInternal = input.bool(true, "Show internal levels")

pivotLen = input.int(5, "Pivot length", minval=2, maxval=40)
minMoveUsd = input.float(700.0, "Minimum move from raw swing", minval=0.0, step=50.0)
structureLookback = input.int(60, "Structure edge lookback", minval=5, maxval=300)
internalResetUsd = input.float(1500.0, "Internal level reset move USD", minval=0.0, step=100.0)
mergeUsd = input.float(120.0, "Merge nearby levels USD", minval=0.0, step=10.0)
maxRaw = input.int(160, "Max raw swings", minval=20, maxval=400)
maxLevels = input.int(120, "Max remembered levels", minval=20, maxval=300)

var float[] rawPrice = array.new<float>()
var bool[] rawIsHigh = array.new<bool>()
var bool[] rawActive = array.new<bool>()
var int[] rawBar = array.new<int>()
var bool[] rawIsStructureEdge = array.new<bool>()

var float[] levelPrice = array.new<float>()
var bool[] levelIsHigh = array.new<bool>()
var string[] levelType = array.new<string>()

var int candCount = 0
var int internalCount = 0
var int rejectedCount = 0
var string lastStatus = "None"
var float lastLevel = na

var float lastCandHigh = na
var float lastCandLow = na
var float lowestSinceCandHigh = na
var float highestSinceCandLow = na

if not na(lastCandHigh)
    lowestSinceCandHigh := na(lowestSinceCandHigh) ? low : math.min(lowestSinceCandHigh, low)
if not na(lastCandLow)
    highestSinceCandLow := na(highestSinceCandLow) ? high : math.max(highestSinceCandLow, high)

hasDuplicate(price, isHigh) =>
    bool duplicate = false
    if array.size(levelPrice) > 0
        for i = 0 to array.size(levelPrice) - 1
            duplicate := duplicate or (array.get(levelIsHigh, i) == isHigh and math.abs(array.get(levelPrice, i) - price) <= mergeUsd)
    duplicate

rememberLevel(price, isHigh, typ) =>
    array.push(levelPrice, price)
    array.push(levelIsHigh, isHigh)
    array.push(levelType, typ)
    if array.size(levelPrice) > maxLevels
        array.shift(levelPrice)
        array.shift(levelIsHigh)
        array.shift(levelType)

addRaw(price, isHigh, originBar, isEdge) =>
    if not na(price)
        array.push(rawPrice, price)
        array.push(rawIsHigh, isHigh)
        array.push(rawActive, true)
        array.push(rawBar, originBar)
        array.push(rawIsStructureEdge, isEdge)
        if array.size(rawPrice) > maxRaw
            array.shift(rawPrice)
            array.shift(rawIsHigh)
            array.shift(rawActive)
            array.shift(rawBar)
            array.shift(rawIsStructureEdge)

moveFromRaw(price, isHigh) =>
    isHigh ? price - low : high - price

internalAllowed(isHigh) =>
    isHigh ? (not na(lastCandHigh) and not na(lowestSinceCandHigh) and lastCandHigh - lowestSinceCandHigh >= internalResetUsd) : (not na(lastCandLow) and not na(highestSinceCandLow) and highestSinceCandLow - lastCandLow >= internalResetUsd)

ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)

highestAtOrigin = ta.highest(high, structureLookback)[pivotLen]
lowestAtOrigin = ta.lowest(low, structureLookback)[pivotLen]

if not na(ph)
    isHighEdge = ph >= highestAtOrigin
    addRaw(ph, true, bar_index - pivotLen, isHighEdge)

if not na(pl)
    isLowEdge = pl <= lowestAtOrigin
    addRaw(pl, false, bar_index - pivotLen, isLowEdge)

if array.size(rawPrice) > 0
    for i = 0 to array.size(rawPrice) - 1
        if array.get(rawActive, i)
            rp = array.get(rawPrice, i)
            rh = array.get(rawIsHigh, i)
            rb = array.get(rawBar, i)
            isEdge = array.get(rawIsStructureEdge, i)
            mv = moveFromRaw(rp, rh)
            if mv >= minMoveUsd
                array.set(rawActive, i, false)
                duplicate = hasDuplicate(rp, rh)
                if duplicate
                    rejectedCount += 1
                    lastStatus := "✕ duplicate"
                    lastLevel := rp
                    if showRejected
                        label.new(rb, rp, "✕ duplicate", style=rh ? label.style_label_down : label.style_label_up, color=color.new(color.gray, 0), textcolor=color.white, size=size.tiny)
                else if isEdge
                    rememberLevel(rp, rh, "candidate")
                    candCount += 1
                    lastStatus := rh ? "Cand. High" : "Cand. Low"
                    lastLevel := rp
                    if rh
                        lastCandHigh := rp
                        lowestSinceCandHigh := low
                    else
                        lastCandLow := rp
                        highestSinceCandLow := high
                    if showCandidates
                        label.new(rb, rp, rh ? "Cand. High" : "Cand. Low", style=rh ? label.style_label_down : label.style_label_up, color=rh ? color.new(color.red, 0) : color.new(color.lime, 0), textcolor=color.white, size=size.tiny)
                else if internalAllowed(rh)
                    rememberLevel(rp, rh, "internal")
                    internalCount += 1
                    lastStatus := rh ? "Inter. High" : "Inter. Low"
                    lastLevel := rp
                    if showInternal
                        label.new(rb, rp, rh ? "Inter. High" : "Inter. Low", style=rh ? label.style_label_down : label.style_label_up, color=color.new(color.blue, 0), textcolor=color.white, size=size.tiny)
                else
                    rejectedCount += 1
                    lastStatus := "✕ not edge"
                    lastLevel := rp
                    if showRejected
                        label.new(rb, rp, "✕ not edge", style=rh ? label.style_label_down : label.style_label_up, color=color.new(color.gray, 0), textcolor=color.white, size=size.tiny)

var table dash = table.new(position.top_right, 2, 7, border_width=1)
if showDashboard and barstate.islast
    table.clear(dash, 0, 0, 1, 6)
    table.cell(dash, 0, 0, "Version", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 1, 0, "Structure + Internal v0.2", text_color=color.white, bgcolor=color.new(color.black, 0))
    table.cell(dash, 0, 1, "Lookback", text_color=color.white)
    table.cell(dash, 1, 1, str.tostring(structureLookback), text_color=color.white)
    table.cell(dash, 0, 2, "Internal reset", text_color=color.white)
    table.cell(dash, 1, 2, str.tostring(internalResetUsd), text_color=color.white)
    table.cell(dash, 0, 3, "Cand. / Inter. / ✕", text_color=color.white)
    table.cell(dash, 1, 3, str.tostring(candCount) + " / " + str.tostring(internalCount) + " / " + str.tostring(rejectedCount), text_color=color.white)
    table.cell(dash, 0, 4, "Last", text_color=color.white)
    table.cell(dash, 1, 4, lastStatus + (na(lastLevel) ? "" : " " + str.tostring(lastLevel, format.mintick)), text_color=color.white)
    table.cell(dash, 0, 5, "Since Cand. High", text_color=color.white)
    table.cell(dash, 1, 5, na(lastCandHigh) or na(lowestSinceCandHigh) ? "" : str.tostring(lastCandHigh - lowestSinceCandHigh, "#.##"), text_color=color.white)
    table.cell(dash, 0, 6, "Since Cand. Low", text_color=color.white)
    table.cell(dash, 1, 6, na(lastCandLow) or na(highestSinceCandLow) ? "" : str.tostring(highestSinceCandLow - lastCandLow, "#.##"), text_color=color.white)
