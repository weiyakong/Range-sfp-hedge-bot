{
  "name": "btc-derivatives-collector",
  "version": "1.0.0",
  "description": "Cloudflare Worker collector for BTC derivatives data from Coinalyze into D1",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "dev": "wrangler dev",
    "dev:test-scheduled": "wrangler dev --test-scheduled"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "wrangler": "^4.142.0"
  }
}
